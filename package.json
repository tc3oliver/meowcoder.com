{
  "name": "meowcoder.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "linkcheck": "npm run linkcheck:site && npm run linkcheck:docs",
    "linkcheck:site": "linkinator ./ --server-root dist --recurse --silent --skip \"^https://(signal\\.)?meowcoder\\.com\"",
    "linkcheck:docs": "linkinator README.md LICENSE-CONTENT.md --markdown --silent",
    "lighthouse": "lhci autorun",
    "test": "vitest run"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@rgrove/parse-xml": "^4.2.3",
    "astro": "^7.3.2",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.12.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4"
  }
}
