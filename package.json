{
  "name": "meowcoder.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "linkcheck": "npm run linkcheck:site && npm run linkcheck:docs",
    "linkcheck:site": "linkinator index.html --server-root dist --recurse --silent --skip \"^https://meowcoder\\.com|^https://github\\.com/tc3oliver/meowcoder\\.com\"",
    "linkcheck:docs": "linkinator README.md LICENSE-CONTENT.md --markdown --silent",
    "test": "vitest run"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@rgrove/parse-xml": "^4.2.3",
    "astro": "^7.2.0",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.9.0",
    "linkinator": "^8.0.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
