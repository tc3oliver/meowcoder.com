---
import type { AboutStrings } from '../../i18n/pages/about';
import AboutSection from './AboutSection.astro';
import CareerProgression from './CareerProgression.astro';

interface Props {
  t: AboutStrings;
}

const { t } = Astro.props;
---

<div class="container about">
  <header class="about__opening">
    <p class="about__eyebrow">{t.eyebrow}</p>
    <h1>{t.heading}</h1>
    <p class="about__role">{t.role}</p>
    <p class="about__lede">{t.intro}</p>
    {t.summary.map((paragraph) => <p class="about__paragraph">{paragraph}</p>)}
  </header>

  <AboutSection id="career" heading={t.career.heading} prominence="strong">
    <CareerProgression career={t.career} id="career-progression" />
  </AboutSection>

  <AboutSection id="engineering-focus" heading={t.focus.heading}>
    <div class="focus-grid">
      {
        t.focus.items.map((item) => (
          <article class="focus-item">
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>
  </AboutSection>

  <AboutSection id="research" heading={t.research.heading} prominence="strong">
    <div class="research">
      <p class="research__venue">{t.research.venue}</p>
      <p class="research__record">{t.research.record}</p>
      <h3 class="research__paper"><cite>{t.research.paper}</cite></h3>
      <p class="research__detail">{t.research.detail}</p>
      <ul class="metadata-list" role="list" aria-label={t.research.areasLabel}>
        {t.research.areas.map((area) => <li>{area}</li>)}
      </ul>
      <a class="about-link" href={t.research.href} rel="external">
        {t.research.cta}<span aria-hidden="true">↗</span>
      </a>
    </div>
  </AboutSection>

  <div class="about__credentials-row">
    <AboutSection id="education" heading={t.education.heading}>
      <div class="education">
        <p class="education__degree">{t.education.degree}</p>
        <p class="education__institution">{t.education.institution}</p>
      </div>
    </AboutSection>

    <AboutSection id="selected-credentials" heading={t.credentials.heading}>
      <ul class="credentials" role="list">
        {
          t.credentials.items.map((credential) => (
            <li class="credentials__item">
              <p class="credentials__name">{credential.name}</p>
              <p class="credentials__meta">{credential.meta}</p>
              {credential.note && <p class="credentials__meta">{credential.note}</p>}
            </li>
          ))
        }
      </ul>
    </AboutSection>
  </div>

  <AboutSection id="engineering-principles" heading={t.principles.heading}>
    <div class="principles">
      <p class="principles__statement">{t.principles.statement}</p>
      <ul class="principles__list" role="list">
        {t.principles.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </AboutSection>
</div>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .about__opening {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--width-reading);
  }

  .about__eyebrow,
  .research__record {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .about__role {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  .about__lede {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    margin-block-start: var(--space-2);
  }

  .about__paragraph,
  .focus-item p,
  .research__detail {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .focus-item {
    min-width: 0;
    padding: var(--space-5) 0;
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .focus-item:nth-child(odd) {
    padding-inline-end: var(--space-7);
  }

  .focus-item:nth-child(even) {
    padding-inline-start: var(--space-7);
    border-inline-start: var(--border-width) solid var(--color-border);
  }

  .focus-item h3 {
    font-size: var(--text-md);
    margin-block-end: var(--space-2);
  }

  .research {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    max-width: var(--width-reading);
  }

  .research__venue {
    font-weight: var(--weight-semibold);
  }

  .research__paper {
    font-size: clamp(var(--text-lg), 3vw, var(--text-xl));
    line-height: var(--leading-snug);
    margin-block: var(--space-2);
  }

  .research__paper cite {
    font-style: normal;
  }

  .metadata-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-block-start: var(--space-2);
  }

  .metadata-list li:not(:last-child)::after {
    content: '·';
    margin-inline-start: var(--space-3);
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    margin-block-start: var(--space-2);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.3em;
  }

  .about-link:hover {
    text-decoration-color: currentColor;
  }

  .about__credentials-row {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-9);
  }

  .education,
  .credentials__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .education__degree,
  .credentials__name {
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .education__institution,
  .credentials__meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .credentials {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin: 0;
  }

  .principles {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--space-8);
    align-items: start;
  }

  .principles__statement {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }

  .principles__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .principles__list li {
    padding: var(--space-3) var(--space-2);
    border-block-end: var(--border-width) solid var(--color-border);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  @media (width < 48rem) {
    .focus-grid,
    .about__credentials-row,
    .principles {
      grid-template-columns: minmax(0, 1fr);
    }

    .focus-item:nth-child(odd),
    .focus-item:nth-child(even) {
      padding-inline: 0;
      border-inline-start: 0;
    }

    .about__credentials-row,
    .principles {
      gap: var(--space-7);
    }
  }

  @media (width < 30rem) {
    .principles__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
