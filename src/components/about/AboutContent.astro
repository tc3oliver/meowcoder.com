---
/**
 * The About page body (MCD-25, doc-2 §14).
 *
 * Both locales render through this one component so the English and Chinese
 * pages cannot drift apart in structure, section order, or markup — only the
 * strings differ.
 *
 * doc-2 §14 replaced the earlier stack of equal-weight sections with a curated
 * composition, which is what the markup below builds:
 *
 *   opening (narrative) + career progression
 *
 *   Engineering Background        Research
 *   Education                     Credentials
 *
 *   Engineering Principles
 *
 * The opening is the only prose on the page, so it alone is held to the
 * reading measure; the paired sections take the full content width and split
 * it. Below 48rem the pairs collapse into one column in source order, so the
 * page still reads background → research → education → credentials. The
 * pairing keeps credentials low on the page, where PRD §16 wants them, without
 * spending a full-width row on two short entries.
 *
 * Two omissions are deliberate:
 *
 *   - The publication and ORCID are cited as text, not linked. Both addresses
 *     are known now (`src/lib/external.ts`), but the reader is one row away
 *     from either: the ORCID link is in the footer of this very page, and the
 *     homepage Research section carries the DOI as its CTA. Repeating them
 *     inside a citation would add link weight without adding a destination.
 *   - There is no résumé download. PRD §14 and §20 keep the original résumé out
 *     of the public repository entirely, and doc-2 §14 rules out growing this
 *     page into a full CV wall.
 */

import type { AboutStrings } from '../../i18n/pages/about';
import AboutSection from './AboutSection.astro';
import CareerProgression from './CareerProgression.astro';
import TermList from './TermList.astro';

interface Props {
  t: AboutStrings;
}

const { t } = Astro.props;
---

<div class="container about">
  <header class="about__opening">
    <h1>{t.heading}</h1>
    <p class="about__lede">{t.intro}</p>
    {t.summary.map((paragraph) => <p class="about__paragraph">{paragraph}</p>)}
  </header>

  <CareerProgression career={t.career} id="career-progression" />

  <div class="about__composition">
    <AboutSection id="engineering-background" heading={t.background.heading}>
      <TermList items={t.background.items} />
    </AboutSection>

    <AboutSection id="research" heading={t.research.heading}>
      <div class="about__stack">
        <p class="research__venue">{t.research.venue}</p>
        <p class="research__paper"><cite>{t.research.paper}</cite></p>
        {
          /* The contribution in plain terms. doc-2 §9 took IND-CCA / OW-CCA off
            the homepage — more than homepage credibility needs — and placed it
            here, where a reader has already chosen to go deeper. */
        }
        <p class="research__detail">{t.research.detail}</p>
        <p class="about__label">{t.research.areasLabel}</p>
        <TermList items={t.research.areas} />
      </div>
    </AboutSection>

    <AboutSection id="education" heading={t.education.heading}>
      <div class="about__stack">
        <p class="education__degree">{t.education.degree}</p>
        <p class="education__institution">{t.education.institution}</p>
      </div>
    </AboutSection>

    <AboutSection id="selected-credentials" heading={t.credentials.heading}>
      {
        /* Text entries only. PRD §16 rules out a display built from vendor
          marks, and course-completion certificates are not listed here at all. */
      }
      <ul class="credentials" role="list">
        {
          t.credentials.items.map((credential) => (
            <li class="credentials__item">
              <p class="credentials__name">{credential.name}</p>
              <p class="credentials__meta">{credential.meta}</p>
              {credential.note && <p class="credentials__meta">{credential.note}</p>}
            </li>
          ))
        }
      </ul>
    </AboutSection>
  </div>

  <AboutSection id="engineering-principles" heading={t.principles.heading}>
    <div class="about__stack">
      <p class="principles__statement">{t.principles.statement}</p>
      <TermList items={t.principles.items} />
    </div>
  </AboutSection>
</div>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .about__opening {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    /* Prose keeps the reading measure even though the page around it is now
       the full content width — PRD §25. */
    max-width: var(--width-reading);
  }

  .about__lede {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    margin-block-start: var(--space-2);
  }

  .about__paragraph {
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  /* -----------------------------------------------------------------------
   * Curated composition (doc-2 §14)
   * -------------------------------------------------------------------- */

  .about__composition {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7) var(--space-9);
  }

  /* One column below the breakpoint, in source order. */
  @media (width < 48rem) {
    .about__composition {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .about__stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .about__label {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  /* -----------------------------------------------------------------------
   * Research (PRD §15, doc-2 §9)
   * -------------------------------------------------------------------- */

  .research__venue {
    font-weight: var(--weight-semibold);
  }

  .research__paper {
    line-height: var(--leading-snug);
  }

  .research__paper cite {
    color: var(--color-text-muted);
  }

  .research__detail {
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin-block-start: var(--space-1);
  }

  /* -----------------------------------------------------------------------
   * Education (PRD §15)
   * -------------------------------------------------------------------- */

  .education__degree {
    font-weight: var(--weight-semibold);
  }

  .education__institution {
    color: var(--color-text-muted);
  }

  /* -----------------------------------------------------------------------
   * Credentials (PRD §16)
   * -------------------------------------------------------------------- */

  .credentials {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin: 0;
  }

  .credentials__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .credentials__name {
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    /* The English page's first credential is a Chinese certificate name
       (doc-2 §15). It must wrap like any other text — no truncation, no clamp,
       and no assumption that this field is Latin. */
    overflow-wrap: break-word;
  }

  .credentials__meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* -----------------------------------------------------------------------
   * Principles (PRD §17)
   * -------------------------------------------------------------------- */

  .principles__statement {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    max-width: var(--width-reading);
    margin-block-end: var(--space-2);
  }
</style>
