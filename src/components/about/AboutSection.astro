---
/**
 * One About section (MCD-8, MCD-25).
 *
 * Every section on the page is a labelled landmark with the same heading
 * rhythm, so the composition doc-2 §14 asks for is built by placing these, not
 * by giving one of them a louder treatment than the rest. The heading id is
 * supplied by the caller and reused for `aria-labelledby`, which is what gives
 * each `<section>` an accessible name in the landmark list.
 */

interface Props {
  /** Id for the heading; also the section's `aria-labelledby` target. */
  id: string;
  heading: string;
  prominence?: 'default' | 'strong';
}

const { id, heading, prominence = 'default' } = Astro.props;
---

<section
  class:list={['about-section', { 'about-section--strong': prominence === 'strong' }]}
  aria-labelledby={id}
>
  <h2 class="about-section__heading" id={id}>{heading}</h2>
  <slot />
</section>

<style>
  .about-section {
    /* The separator between sections is the whitespace plus one hairline —
       PRD §25 asks for thin borders and large whitespace, not cards. */
    border-block-start: var(--border-width) solid var(--color-border);
    padding-block-start: var(--space-7);
    /* Paired sections are grid items in the doc-2 §14 composition, and a grid
       item's `auto` minimum lets long content push past its track. */
    min-width: 0;
  }

  .about-section__heading {
    /* Section headings sit a step below the page title so the h1 keeps the
       hierarchy, while the sections stay peers of one another. */
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-normal);
    margin-block-end: var(--space-5);
  }

  .about-section--strong .about-section__heading {
    font-size: var(--text-xl);
  }
</style>
