---
import type { AboutStrings } from '../../i18n/pages/about';

interface Props {
  career: AboutStrings['career'];
  id: string;
}

const { career, id } = Astro.props;
---

<div class="progression">
  <p class="progression__label" id={id}>{career.label}</p>
  <ol class="progression__stages" role="list" aria-labelledby={id}>
    {
      career.stages.map((stage, index) => (
        <li class="progression__stage">
          {index > 0 && (
            <span class="progression__arrow" aria-hidden="true">
              →
            </span>
          )}
          <span>{stage}</span>
        </li>
      ))
    }
  </ol>
  <p class="progression__summary">{career.summary}</p>
  <a class="progression__cta" href={career.href}>
    {career.cta}<span aria-hidden="true">→</span>
  </a>
</div>

<style>
  .progression {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .progression__label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .progression__stages {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    margin: 0;
  }

  .progression__stage {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
    font-size: clamp(var(--text-md), 2.6vw, var(--text-lg));
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .progression__arrow {
    color: var(--color-text-muted);
    font-weight: var(--weight-normal);
  }

  .progression__summary {
    max-width: var(--width-reading);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .progression__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.3em;
  }

  .progression__cta:hover {
    text-decoration-color: currentColor;
  }

  @media (width < 48rem) {
    .progression__stages {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .progression__stage {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .progression__arrow {
      rotate: 90deg;
    }
  }
</style>
