---
import type { AboutStrings } from '../../i18n/pages/about';

interface Props {
  career: AboutStrings['career'];
  id: string;
}

const { career, id } = Astro.props;
---

<div class="progression">
  <p class="progression__label" id={id}>{career.label}</p>
  <ol class="progression__stages" role="list" aria-labelledby={id}>
    {
      career.stages.map((stage, index) => (
        <li class="progression__stage">
          {index > 0 && (
            <span class="progression__arrow" aria-hidden="true">
              →
            </span>
          )}
          <div class="progression__stage-content">
            <p class="progression__period">{stage.period}</p>
            <h3>{stage.name}</h3>
            <p class="progression__description">{stage.description}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="progression__summary">{career.summary}</p>
  <a class="progression__cta" href={career.href}>
    {career.cta}<span aria-hidden="true">→</span>
  </a>
</div>

<style>
  .progression {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .progression__label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .progression__stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: stretch;
    gap: var(--space-5);
    width: 100%;
    margin: 0;
  }

  .progression__stage {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-5);
    min-width: 0;
  }

  .progression__stage-content {
    min-width: 0;
  }

  .progression__stage:first-child .progression__stage-content {
    grid-column: 1 / -1;
  }

  .progression__period {
    margin-block-end: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
  }

  .progression__stage h3 {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }

  .progression__description {
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .progression__arrow {
    margin-block-start: var(--space-6);
    color: var(--color-text-muted);
    font-weight: var(--weight-normal);
  }

  .progression__summary {
    max-width: var(--width-reading);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .progression__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.3em;
  }

  .progression__cta:hover {
    text-decoration-color: currentColor;
  }

  @media (width < 48rem) {
    .progression__stages {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .progression__stage {
      grid-template-columns: 1.5rem minmax(0, 1fr);
      gap: var(--space-3);
    }

    .progression__arrow {
      rotate: 90deg;
      margin-block-start: 0;
    }

    .progression__stage:first-child .progression__stage-content {
      grid-column: 2;
    }
  }
</style>
