---
/**
 * Engineering Expertise (MCD-4, PRD §9.3, §5).
 *
 * Exactly the four pillars PRD §5 defines, one concise explanation each. PRD
 * §9.3 forbids replacing them with a technology grid, so the technologies that
 * do appear are inside a sentence explaining what the pillar covers, never as a
 * standalone list of framework names.
 *
 * PRD §12 shapes the LLM Infrastructure pillar specifically. It is an expertise
 * area, and its public proof is technical writing — the strongest evidence sits
 * in confidential employer systems, so nothing here implies a public case study
 * exists. That is the one asymmetry between the four blocks, and it is
 * deliberate: whichever pillar the dictionary marks with `evidence` gets a link
 * to Study. The marking lives in the dictionary rather than in a name match
 * here, because the Chinese pillar is not called "LLM Infrastructure".
 */

import type { HomeStrings } from '../../i18n/pages/home';
import { STUDY_URL } from '../../lib/external';
import CtaLink from './CtaLink.astro';
import HomeSection from './HomeSection.astro';

interface Props {
  t: HomeStrings;
  externalIndicator: string;
}

const { t, externalIndicator } = Astro.props;
---

<HomeSection id="engineering-expertise" heading={t.expertise.heading}>
  <p class="expertise__intro">{t.expertise.intro}</p>

  <ul class="expertise" role="list">
    {
      t.expertise.pillars.map((pillar) => (
        <li class="expertise__pillar">
          <h3 class="expertise__name">{pillar.name}</h3>
          <p class="expertise__description">{pillar.description}</p>
          {pillar.evidence && (
            <p class="expertise__evidence">
              <CtaLink
                href={STUDY_URL}
                label={pillar.evidence.label}
                external
                indicator={externalIndicator}
              />
            </p>
          )}
        </li>
      ))
    }
  </ul>
</HomeSection>

<style>
  .expertise__intro {
    max-width: var(--width-reading);
    margin-block-end: var(--space-6);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .expertise {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-6) var(--space-7);
    margin: 0;
  }

  .expertise__pillar {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .expertise__name {
    font-size: var(--text-md);
    letter-spacing: var(--tracking-normal);
  }

  .expertise__description {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .expertise__evidence {
    margin-block-start: var(--space-1);
  }
</style>
