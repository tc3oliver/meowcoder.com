---
/**
 * Evidence-first homepage: the one investigation worth lingering on, then
 * independent upstream contributions, selected systems, and curated writing.
 * Both locales use exactly the same composition.
 */
import type { Locale } from '../../i18n/locales';
import type { HomeStrings } from '../../i18n/pages/home';
import type { StudyPost } from '../../lib/study-feed';
import AboutNav from './AboutNav.astro';
import HomeHero from './HomeHero.astro';
import OssContributionsSection from './OssContributionsSection.astro';
import ProductsSection from './ProductsSection.astro';
import ResearchWritingSection from './ResearchWritingSection.astro';
import SystemsResearchSection from './SystemsResearchSection.astro';

interface Props {
  locale: Locale;
  t: HomeStrings;
  posts: readonly StudyPost[];
  externalIndicator: string;
}

const { locale, t, posts, externalIndicator } = Astro.props;
---

<div class="container home">
  <HomeHero t={t} />
  <SystemsResearchSection locale={locale} t={t} index="01" externalIndicator={externalIndicator} />
  <OssContributionsSection t={t} index="02" externalIndicator={externalIndicator} />
  <ProductsSection locale={locale} t={t} index="03" externalIndicator={externalIndicator} />
  <ResearchWritingSection
    locale={locale}
    t={t}
    posts={posts}
    index="04"
    externalIndicator={externalIndicator}
  />
  <AboutNav locale={locale} t={t} />
</div>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
</style>
