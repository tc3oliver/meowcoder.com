---
/**
 * The homepage body (MCD-4, MCD-16, doc-2 §5).
 *
 * Both locales render through this one component, so the English and Chinese
 * homepages cannot drift apart in structure or section order — only the strings
 * and the feed titles differ. That is what PRD §35 means by "the Chinese
 * version follows the same information architecture".
 *
 * The order below is doc-2 §5's order, which replaces PRD §35. It is the
 * visitor journey read top to bottom, and it now front-loads the two sections
 * that carry inspectable evidence:
 *
 *   Hero                    Who is Oliver?
 *   Featured Product        Can he build a real product?
 *   Featured Research       Can he find and prove a root cause?
 *   Open Source + Upstream  Can I inspect his implementation, and does it
 *                           hold up in other people's projects?
 *   Research + Writing      Is there deeper technical credibility, and can I
 *                           inspect his technical thinking?
 *   Experience strip        What experience supports this?
 *
 * Engineering Focus, doc-2 §8's four areas with a line each, is gone. It was
 * a signalling section rather than evidence, and once Featured Research and
 * the upstream list carried the proof it only restated them: two of its
 * pillars linked to the same case study and a third to a project already
 * featured above it. Research and Technical Writing are one component rather
 * than two: doc-2 §9 makes them a single two-column band, which is
 * `ResearchWritingSection`.
 *
 * The last item, the footer, is site chrome and is rendered by `SiteShell`
 * after this component — it is the same link row on every route (PRD §9.8).
 */

import type { Locale } from '../../i18n/locales';
import type { HomeStrings } from '../../i18n/pages/home';
import type { StudyPost } from '../../lib/study-feed';
import ExperienceSection from './ExperienceSection.astro';
import HomeHero from './HomeHero.astro';
import OpenSourceSection from './OpenSourceSection.astro';
import ResearchWritingSection from './ResearchWritingSection.astro';
import ShouriSection from './ShouriSection.astro';
import SystemsResearchSection from './SystemsResearchSection.astro';

interface Props {
  locale: Locale;
  t: HomeStrings;
  /** Latest Study posts, already limited and ordered by `getStudyPosts`. */
  posts: readonly StudyPost[];
  /** Localized off-site glyph, from the chrome dictionary. */
  externalIndicator: string;
}

const { locale, t, posts, externalIndicator } = Astro.props;
---

<div class="container home">
  <HomeHero locale={locale} t={t} externalIndicator={externalIndicator} />
  <ShouriSection locale={locale} t={t} externalIndicator={externalIndicator} />
  <SystemsResearchSection locale={locale} t={t} externalIndicator={externalIndicator} />
  <OpenSourceSection locale={locale} t={t} externalIndicator={externalIndicator} />
  <ResearchWritingSection
    locale={locale}
    t={t}
    posts={posts}
    externalIndicator={externalIndicator}
  />
  <ExperienceSection locale={locale} t={t} />
</div>

<style>
  .home {
    display: flex;
    flex-direction: column;
    /* No gap. Each section owns the whitespace around its separator: a compact
       end padding keeps the preceding action or visual off the rule, while
       `--space-section` provides the larger opening rhythm after it. */
    gap: 0;
  }
</style>
