---
/**
 * Homepage hero (MCD-4, MCD-16, doc-2 §5).
 *
 * Typography and whitespace carry the whole section. PRD §9.1 and §25 rule out
 * every piece of the usual portfolio hero furniture — the large portrait, the
 * decorative AI artwork, the animated code, the self-writing headline, the
 * vendor mark row, the proficiency bars — so there is no image, no canvas, and
 * no client-side JavaScript here at all. `src/styles/design-system.test.ts`
 * scans the source tree for each of them by name.
 *
 * The two facts beneath the statement are plain text, not badges: PRD §37
 * prefers evidence over ornament, and "10+ Years in Software Engineering" is
 * already the evidence.
 *
 * doc-2 §5 asks for a hero that is confident and spacious but not an empty
 * full-screen splash: the next section has to be reachable within about one
 * screen. Two things hold that. The name is the one element on the page that
 * takes `--text-display`, so the scale does the work a taller block would
 * otherwise do; and the hero adds no bottom padding, leaving the gap to
 * Featured Product as exactly the `--space-section` that section already
 * carries.
 */

import type { Locale } from '../../i18n/locales';
import type { HomeStrings } from '../../i18n/pages/home';
import { localizePath } from '../../lib/i18n';
import { STUDY_URL } from '../../lib/external';
import CtaLink from './CtaLink.astro';

interface Props {
  locale: Locale;
  t: HomeStrings;
  /** Localized off-site glyph, from the chrome dictionary. */
  externalIndicator: string;
}

const { locale, t, externalIndicator } = Astro.props;
---

<div class="hero">
  <p class="hero__role">{t.hero.role}</p>
  <h1 class="hero__name">{t.heading}</h1>
  <p class="hero__statement">{t.intro}</p>

  <ul class="hero__facts" role="list">
    {t.hero.facts.map((fact) => <li>{fact}</li>)}
  </ul>

  <div class="hero__actions">
    <CtaLink href={localizePath(locale, '/work')} label={t.hero.workCta} variant="solid" />
    <CtaLink
      href={STUDY_URL}
      label={t.hero.writingCta}
      external
      indicator={externalIndicator}
      variant="outline"
    />
  </div>
</div>

<style>
  .hero {
    /* Held to the reading measure so the statement breaks where doc-2 §5
       writes it, rather than stretching across the full content width. */
    max-width: var(--width-reading);
  }

  .hero__role {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
  }

  /* The page's focal point, and the only element that opts into the display
     step — doc-2 §4 puts the desktop hero name at 64–72px, above every
     numbered step in the scale. Leading and tracking still come from the `h1`
     baseline in `global.css`. */
  .hero__name {
    margin-block-start: var(--space-2);
    font-size: var(--text-display);
  }

  .hero__statement {
    margin-block-start: var(--space-5);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin-block-start: var(--space-7);
  }
</style>
