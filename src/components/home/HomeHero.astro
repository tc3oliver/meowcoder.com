---
/**
 * Homepage masthead (MCD-4, MCD-16, doc-2 §5; round-2 "Engineering Ledger").
 *
 * Typography and whitespace carry the whole section. PRD §9.1 and §25 rule out
 * every piece of the usual portfolio hero furniture — the large portrait, the
 * decorative AI artwork, the animated code, the self-writing headline, the
 * vendor mark row, the proficiency bars — so there is no image, no canvas, and
 * no client-side JavaScript here at all. `src/styles/design-system.test.ts`
 * scans the source tree for each of them by name.
 *
 * Round 2 composes the hero as an asymmetric ledger masthead: the oversized
 * name leads a wide left column (role line in mono, statement under it), and a
 * narrow right rail — desktop only — carries the hairline-separated mono
 * facts. Round 3 drops the two hero actions: the numbered sections below are
 * the page's navigation, and a masthead with nothing to click reads calmer.
 * The facts are plain text, not badges: PRD §37 prefers evidence over
 * ornament, and a shipped release and upstream projects are the evidence. The
 * list renders however many facts the dictionary carries; it does not assume a
 * count.
 *
 * doc-2 §5 asks for a hero that is confident and spacious but not an empty
 * full-screen splash: the next section has to be reachable within about one
 * screen. `--space-hero` gives the block its presence while the name's display
 * step does the rest; the next section owns the larger opening rhythm after it.
 */

import type { HomeStrings } from '../../i18n/pages/home';

interface Props {
  t: HomeStrings;
}

const { t } = Astro.props;
const noBreakSuffix = t.hero.noBreakSuffix;
const statementStart =
  noBreakSuffix && t.intro.endsWith(noBreakSuffix)
    ? t.intro.slice(0, -noBreakSuffix.length)
    : t.intro;
---

<div class="hero">
  <div class="hero__main">
    <h1 class="hero__name">{t.heading}</h1>
    <p class="hero__role">{t.hero.role}</p>
    <p class="hero__thesis">{t.hero.thesis}</p>
    <p class="hero__statement">
      {statementStart}{
        noBreakSuffix && t.intro.endsWith(noBreakSuffix) && (
          <span class="hero__statement-tail">{noBreakSuffix}</span>
        )
      }
    </p>
  </div>

  <div class="hero__rail">
    <ul class="hero__facts" role="list">
      {t.hero.facts.map((fact) => <li>{fact}</li>)}
    </ul>
  </div>
</div>

<style>
  /* One column on a phone; the asymmetric two-column masthead from 64rem. The
     grid spans the full content width — the width contrast against the narrow
     prose inside the sections below is part of the round-2 identity.

     Round 3 trims the bottom padding to `--space-10`: with no CTA to anchor
     the eye at the end of the masthead, the "01" eyebrow of the research
     section has to appear within about one screen (doc-2 §5) instead of below
     a full second hero band. The top keeps the full `--space-hero` presence. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    padding-block: var(--space-hero) var(--space-10);
  }

  @media (width >= 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
      column-gap: var(--space-9);
    }
  }

  .hero__main {
    min-width: 0;
  }

  /* The page's focal point, and the only element that opts into the display
     step. At that size the `h1` baseline leading is too loose and the default
     tracking too wide, so this element overrides both with the masthead tokens. */
  .hero__name {
    font-size: var(--text-display);
    line-height: var(--leading-masthead);
    letter-spacing: var(--tracking-masthead);
  }

  /* The role line is metadata under the ledger identity: mono, muted. No
     letter-spacing — the line is visible on zh pages, where spacing Latin out
     does nothing for the Chinese reader (PRD §7). */
  .hero__role {
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-md);
  }

  .hero__thesis {
    max-width: 18ch;
    margin-block-start: var(--space-6);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .hero__statement {
    /* A statement measure, not a prose one: ~34em keeps the Traditional
       Chinese line from breaking inside its final technical term. */
    max-width: 34em;
    margin-block-start: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .hero__statement-tail {
    white-space: nowrap;
  }

  /* The right rail: hairline-topped, its fact rows separated by hairlines. On
     mobile the same stack simply follows the statement. The facts are now the
     rail's whole content, so their rows get the taller `--space-4` padding —
     two tight rows under a hairline would read as leftovers from the removed
     actions rather than as a deliberate metadata block. */
  .hero__rail {
    min-width: 0;
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .hero__facts {
    display: flex;
    flex-direction: column;
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .hero__facts li {
    padding-block: var(--space-4);
  }

  .hero__facts li + li {
    border-block-start: var(--border-width) solid var(--color-border);
  }
</style>
