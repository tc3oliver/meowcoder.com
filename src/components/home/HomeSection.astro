---
/**
 * One homepage section (MCD-4, MCD-15).
 *
 * The homepage is a sequence of equal-weight sections (PRD §35), so each gets
 * the same landmark treatment: generous whitespace and a heading that names
 * the section for the landmark list via `aria-labelledby`. There is no eyebrow
 * above the heading; the page is a text column and the heading says what the
 * section is.
 */

interface Props {
  /** Id for the heading; also the section's `aria-labelledby` target. */
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
---

<section class="home-section" aria-labelledby={id}>
  <h2 class="home-section__heading" id={id}>{heading}</h2>
  <slot />
</section>

<style>
  .home-section {
    /* Whitespace only, no rule and never a card — PRD §25. The whitespace is
       the section rhythm doc-2 §4 asks for: ~72px on a phone, ~128px on a
       desktop. */
    padding-block-start: var(--space-section);
    padding-block-end: var(--space-6);
  }

  /* The homepage is a text column like Study, so the heading steps down from
     the `h2` baseline in `global.css` to `--text-xl`. */
  .home-section__heading {
    font-size: var(--text-xl);
    margin-block-end: var(--space-6);
  }
</style>
