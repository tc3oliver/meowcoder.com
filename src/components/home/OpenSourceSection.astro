---
/**
 * Open Source — AI Coding Skills (MCD-18, doc-2 §7).
 *
 * This is the primary open-source proof. PRD §24 keeps it that way: the
 * meowcoder.com source is secondary engineering evidence and gets a footer link
 * rather than a card here.
 *
 * doc-2 §7 compresses the section to a statement, the two skill names, a
 * workflow visual, and two actions. What used to be here — the seven-stage
 * pipeline, "What it defines", "What it demonstrates", and the attribution
 * paragraph — is not gone from the site; it is on the AI Coding Skills case
 * study, which `caseStudyCta` now links to. That includes PRD §9.4's
 * requirement that the bundled third-party `grilling` skill keeps its
 * attribution and licence and is never presented as original work: the case
 * study states it in full, so the homepage can stop restating it without the
 * site losing it.
 *
 * `backlog-workflow` still leads and `audit-claude-md` still follows, in that
 * order and at that weight, because PRD §9.4 states the priority — they are now
 * one line rather than two blocks.
 */

import type { Locale } from '../../i18n/locales';
import type { HomeStrings } from '../../i18n/pages/home';
import { SKILLS_URL } from '../../lib/external';
import { localizePath, workDetailRoute } from '../../lib/i18n';
import WorkflowDiagram from '../WorkflowDiagram.astro';
import CtaLink from './CtaLink.astro';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
  t: HomeStrings;
  externalIndicator: string;
}

const { locale, t, externalIndicator } = Astro.props;

/** The case study's slug — `src/content/work/{en,zh}/ai-coding-skills.md`. */
const CASE_STUDY_SLUG = 'ai-coding-skills';

/**
 * The case study in the reader's own locale. Routing goes through the same
 * helpers the Work index uses, so this link cannot drift from the page it
 * points at.
 */
const caseStudyHref = localizePath(locale, workDetailRoute(CASE_STUDY_SLUG));

/**
 * doc-2 §7 prints the two names as one compact line. The middot is a separator
 * between two proper names rather than punctuation in a sentence, so it is
 * joined here instead of being written into either locale's strings.
 */
const skills = t.openSource.skills.join(' · ');
---

<HomeSection id="open-source" eyebrow={t.openSource.eyebrow} heading={t.openSource.heading}>
  <div class="oss">
    <p class="oss__statement">{t.openSource.statement}</p>

    <p class="oss__skills">{skills}</p>

    <WorkflowDiagram
      caption={t.openSource.workflow.caption}
      start={t.openSource.workflow.start}
      steps={t.openSource.workflow.steps}
      end={t.openSource.workflow.end}
    />

    <div class="oss__actions">
      <CtaLink href={caseStudyHref} label={t.openSource.caseStudyCta.label} variant="outline" />
      <CtaLink
        href={SKILLS_URL}
        label={t.openSource.cta.label}
        external
        indicator={externalIndicator}
        variant="outline"
      />
    </div>
  </div>
</HomeSection>

<style>
  .oss {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    /* The statement is the section's only prose, so the whole block follows it
       to the reading measure rather than stretching to the content width. */
    max-width: var(--width-reading);
  }

  .oss__statement {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }

  /* The two repository names, as one line. Monospace because they are file and
     package identifiers, the same treatment they had as headings. */
  .oss__skills {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-normal);
  }

  .oss__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
