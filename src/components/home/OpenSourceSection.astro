---
/**
 * Open Source — AI Coding Skills (MCD-18, doc-2 §7).
 *
 * This is the primary open-source proof. PRD §24 keeps it that way: the
 * meowcoder.com source is secondary engineering evidence and gets a footer link
 * rather than a card here.
 *
 * doc-2 §7 compresses the section to a statement, the two skill names, a
 * workflow visual, and its actions. The seven-stage pipeline, "What it
 * defines", "What it demonstrates", and the attribution paragraph live in the
 * skills repository, which is the only place the Skills block links to: the
 * site no longer carries a case study for it.
 *
 * Beneath the two projects is the upstream half: pull requests to projects
 * this site's author does not maintain, which is the evidence the GitHub
 * profile leads with. Four are named; the rest are one link away on the
 * profile, whose list is regenerated from GitHub rather than written by hand.
 *
 * `backlog-workflow` still leads and `audit-claude-md` still follows, in that
 * order and at that weight, because PRD §9.4 states the priority — they are now
 * one line rather than two blocks.
 */

import type { Locale } from '../../i18n/locales';
import type { HomeStrings } from '../../i18n/pages/home';
import {
  SIGNALFORGE_LIVE_URL,
  SIGNALFORGE_URL,
  SKILLS_URL,
  UPSTREAM_PRS_URL,
} from '../../lib/external';
import { localizePath, workDetailRoute } from '../../lib/i18n';
import WorkflowDiagram from '../WorkflowDiagram.astro';
import CtaLink from './CtaLink.astro';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
  t: HomeStrings;
  externalIndicator: string;
}

const { locale, t, externalIndicator } = Astro.props;

/** The SignalForge case study's slug — `src/content/work/{en,zh}/<slug>.md`. */
const SIGNALFORGE_SLUG = 'signalforge';
const signalforgeHref = localizePath(locale, workDetailRoute(SIGNALFORGE_SLUG));

/**
 * doc-2 §7 prints the two names as one compact line. The middot is a separator
 * between two proper names rather than punctuation in a sentence, so it is
 * joined here instead of being written into either locale's strings.
 */
const skills = t.openSource.skills.join(' · ');
---

<HomeSection id="open-source" eyebrow={t.openSource.eyebrow} heading={t.openSource.heading}>
  <div class="oss oss--two">
    <div class="oss__project">
      <h3 class="oss__name">{t.openSource.signalforge.heading}</h3>
      <p class="oss__statement">{t.openSource.signalforge.statement}</p>
      <p class="oss__skills">{t.openSource.signalforge.meta}</p>
      <div class="oss__actions">
        <CtaLink
          href={SIGNALFORGE_LIVE_URL}
          label={t.openSource.signalforge.liveCta.label}
          external
          indicator={externalIndicator}
          variant="outline"
        />
        <CtaLink
          href={signalforgeHref}
          label={t.openSource.signalforge.caseStudyCta.label}
          variant="outline"
        />
        <CtaLink
          href={SIGNALFORGE_URL}
          label={t.openSource.signalforge.cta.label}
          external
          indicator={externalIndicator}
          variant="text"
        />
      </div>
    </div>

    <div class="oss__project">
      {/* A repository name, identical in both locales, so it is not in the dictionary. */}
      <h3 class="oss__name">AI Coding Skills</h3>
      <p class="oss__statement">{t.openSource.statement}</p>

      <p class="oss__skills">{skills}</p>

      <WorkflowDiagram
        caption={t.openSource.workflow.caption}
        start={t.openSource.workflow.start}
        steps={t.openSource.workflow.steps}
        end={t.openSource.workflow.end}
      />

      <div class="oss__actions">
        <CtaLink
          href={SKILLS_URL}
          label={t.openSource.cta.label}
          external
          indicator={externalIndicator}
          variant="outline"
        />
      </div>
    </div>
  </div>

  <div class="upstream">
    <h3 class="oss__name">{t.openSource.upstream.heading}</h3>
    <ul class="upstream__list" role="list">
      {
        t.openSource.upstream.items.map((item) => (
          <li class="upstream__item">
            <p class="upstream__name">
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.name}
              </a>
              {item.merged && <span class="upstream__state">{t.openSource.upstream.merged}</span>}
            </p>
            <p class="upstream__description">{item.description}</p>
          </li>
        ))
      }
    </ul>
    <div class="oss__actions">
      <CtaLink
        href={UPSTREAM_PRS_URL}
        label={t.openSource.upstream.cta.label}
        external
        indicator={externalIndicator}
        variant="text"
      />
    </div>
  </div>
</HomeSection>

<style>
  /* Two projects side by side from the point two reading measures fit; one
     column beneath that. Each project keeps its own reading measure, so the
     pair reads as two short columns rather than one wide block. */
  .oss--two {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8) var(--space-8);
  }

  @media (width >= 48rem) {
    .oss--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .oss__project {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: var(--width-reading);
  }

  .oss__name {
    font-size: var(--text-md);
    letter-spacing: var(--tracking-normal);
  }

  .oss__statement {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }

  /* The two repository names, as one line. Monospace because they are file and
     package identifiers, the same treatment they had as headings. */
  .oss__skills {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-normal);
  }

  .upstream {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-block-start: var(--space-8);
  }

  /* Two columns of pull requests from the same breakpoint as the projects
     above, so the list lines up under them rather than running full width. */
  .upstream__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5) var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .upstream__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .upstream__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-normal);
    /* A repository path has no spaces to break at; let it wrap anywhere
       rather than push a 390px viewport sideways. */
    overflow-wrap: anywhere;
  }

  .upstream__state {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
  }

  .upstream__description {
    margin-block-start: var(--space-2);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .oss__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
</style>
