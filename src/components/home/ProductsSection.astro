---
/**
 * Products — Shouri, SignalForge, PiShip and Claude Team Kit as ledger rows:
 * the name linked to its case study, one sentence, and text links out; there
 * are no images, cards or backgrounds. PRD §24 keeps the meowcoder.com source
 * out of this section: it gets a footer link.
 *
 * Round 2 gives each product a full-width row — hairline above, title block
 * left, mono actions right — spanning the content width while the statement
 * stays at a reading measure. The row carries no number of its own; the
 * section's ledger index does that.
 */

import type { Locale } from '../../i18n/locales';
import type { HomeStrings } from '../../i18n/pages/home';
import {
  CLAUDE_TEAM_KIT_URL,
  PISHIP_URL,
  SHOURI_URL,
  SIGNALFORGE_LIVE_URL,
  SIGNALFORGE_URL,
} from '../../lib/external';
import { localizePath, workDetailRoute } from '../../lib/i18n';
import CtaLink from './CtaLink.astro';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
  t: HomeStrings;
  externalIndicator: string;
  /** Two-digit ledger index for the section heading row. */
  index: string;
}

const { locale, t, externalIndicator, index } = Astro.props;

/** `slug` is the case study's — `src/content/work/{en,zh}/<slug>.md`. */
const products = [
  {
    slug: 'shouri',
    name: t.shouri.heading,
    statement: t.shouri.summary,
    links: [{ href: SHOURI_URL, label: t.shouri.cta.label }],
  },
  {
    slug: 'signalforge',
    name: t.products.signalforge.heading,
    statement: t.products.signalforge.statement,
    links: [
      { href: SIGNALFORGE_LIVE_URL, label: t.products.signalforge.liveCta.label },
      { href: SIGNALFORGE_URL, label: t.products.signalforge.cta.label },
    ],
  },
  {
    slug: 'piship',
    name: t.products.piship.heading,
    statement: t.products.piship.statement,
    links: [{ href: PISHIP_URL, label: t.products.piship.cta.label }],
  },
  {
    slug: 'claude-team-kit',
    name: t.products.claudeTeamKit.heading,
    statement: t.products.claudeTeamKit.statement,
    links: [{ href: CLAUDE_TEAM_KIT_URL, label: t.products.claudeTeamKit.cta.label }],
  },
];
---

<HomeSection id="products" heading={t.products.heading} index={index}>
  <ul class="products" role="list">
    {
      products.map((product) => (
        <li class="product">
          <div class="product__main">
            <p class="product__name">
              <a href={localizePath(locale, workDetailRoute(product.slug))}>{product.name}</a>
            </p>
            <p class="product__statement">{product.statement}</p>
          </div>
          <p class="product__links">
            {product.links.map((link) => (
              <CtaLink href={link.href} label={link.label} external indicator={externalIndicator} />
            ))}
          </p>
        </li>
      ))
    }
  </ul>
</HomeSection>

<style>
  .products {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The ledger row: hairline above, title block left, mono actions aligned to
     the row top on the right. One column under 48rem, actions below the
     statement. `minmax(0, …)` keeps a long name from widening a 390px
     viewport. */
  .product {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-6);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .product:last-child {
    border-block-end: var(--border-width) solid var(--color-border);
  }

  @media (width >= 48rem) {
    .product {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-8);
      align-items: start;
    }
  }

  .product__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  /* The title is the row's focal point: one step under the 40px section
     heading (23→28px fluid), so four rows never compete with the ledger
     header. Hover comes from the global `a` rule (accent-strong). */
  .product__name {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    overflow-wrap: anywhere;
  }

  .product__statement {
    /* A statement measure: the row is wide, the sentence is not. */
    max-width: 46em;
    color: var(--color-text-muted);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }

  /* Metadata register: mono, small, stacked. */
  .product__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    font-family: var(--font-mono);
  }
</style>
