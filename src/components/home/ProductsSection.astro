---
/**
 * Two fully realized systems lead; two smaller tools follow in a denser
 * register. This hierarchy distinguishes product/platform ownership from
 * useful OSS utilities without removing any public evidence.
 */
import type { Locale } from '../../i18n/locales';
import type { HomeStrings } from '../../i18n/pages/home';
import {
  CLAUDE_TEAM_KIT_URL,
  PISHIP_URL,
  SHOURI_URL,
  SIGNALFORGE_LIVE_URL,
  SIGNALFORGE_URL,
} from '../../lib/external';
import { localizePath, workDetailRoute } from '../../lib/i18n';
import CtaLink from './CtaLink.astro';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
  t: HomeStrings;
  externalIndicator: string;
  index: string;
}

const { locale, t, externalIndicator, index } = Astro.props;

const featured = [
  {
    slug: 'shouri',
    kind: t.products.labels.product,
    name: t.shouri.heading,
    statement: t.shouri.summary,
    links: [{ href: SHOURI_URL, label: t.shouri.cta.label }],
  },
  {
    slug: 'piship',
    kind: t.products.labels.infrastructure,
    name: t.products.piship.heading,
    statement: t.products.piship.statement,
    links: [{ href: PISHIP_URL, label: t.products.piship.cta.label }],
  },
];

const tools = [
  {
    slug: 'signalforge',
    name: t.products.signalforge.heading,
    statement: t.products.signalforge.statement,
    links: [
      { href: SIGNALFORGE_LIVE_URL, label: t.products.signalforge.liveCta.label },
      { href: SIGNALFORGE_URL, label: t.products.signalforge.cta.label },
    ],
  },
  {
    slug: 'claude-team-kit',
    name: t.products.claudeTeamKit.heading,
    statement: t.products.claudeTeamKit.statement,
    links: [{ href: CLAUDE_TEAM_KIT_URL, label: t.products.claudeTeamKit.cta.label }],
  },
];
---

<HomeSection id="products" heading={t.products.heading} index={index}>
  <ul class="featured-products" role="list">
    {
      featured.map((product) => (
        <li class="featured-product">
          <div class="featured-product__main">
            <p class="featured-product__kind">{product.kind}</p>
            <h3 class="featured-product__name">
              <a href={localizePath(locale, workDetailRoute(product.slug))}>{product.name}</a>
            </h3>
            <p class="featured-product__statement">{product.statement}</p>
          </div>
          <p class="product-links">
            {product.links.map((link) => (
              <CtaLink href={link.href} label={link.label} external indicator={externalIndicator} />
            ))}
          </p>
        </li>
      ))
    }
  </ul>

  <h3 class="tools-heading">{t.products.moreHeading}</h3>
  <ul class="tools" role="list">
    {
      tools.map((product) => (
        <li class="tool">
          <div class="tool__main">
            <h4>
              <a href={localizePath(locale, workDetailRoute(product.slug))}>{product.name}</a>
            </h4>
            <p>{product.statement}</p>
          </div>
          <p class="product-links">
            {product.links.map((link) => (
              <CtaLink href={link.href} label={link.label} external indicator={externalIndicator} />
            ))}
          </p>
        </li>
      ))
    }
  </ul>
</HomeSection>

<style>
  .featured-products,
  .tools {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .featured-product {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .featured-product:last-child,
  .tool:last-child {
    border-block-end: var(--border-width) solid var(--color-border);
  }

  @media (width >= 48rem) {
    .featured-product,
    .tool {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-8);
      align-items: start;
    }
  }

  .featured-product__main,
  .tool__main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    min-width: 0;
  }

  .featured-product__kind,
  .tools-heading {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
  }

  .featured-product__name {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .featured-product__statement {
    max-width: 52ch;
    color: var(--color-text-muted);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }

  .tools-heading {
    margin-block: var(--space-8) var(--space-4);
  }

  .tool {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .tool__main h4 {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .tool__main p {
    max-width: 56ch;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .product-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
