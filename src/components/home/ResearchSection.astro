---
/**
 * Research — JISA publication (MCD-4, PRD §9.5).
 *
 * One publication, presented inline. PRD §9.5 and §8 both forbid promoting a
 * single paper into its own navigation entry, so this section is the whole of
 * Research on the site's primary journey; the fuller context lives on About.
 *
 * The `View Publication ↗` call to action PRD §9.5 specifies resolves through
 * the paper's DOI rather than a publisher URL, so it survives the article being
 * moved or re-platformed.
 */

import type { HomeStrings } from '../../i18n/pages/home';
import { PUBLICATION_URL } from '../../lib/external';
import CtaLink from './CtaLink.astro';
import HomeSection from './HomeSection.astro';

interface Props {
  t: HomeStrings;
  externalIndicator: string;
}

const { t, externalIndicator } = Astro.props;
---

<HomeSection id="research" eyebrow={t.research.eyebrow} heading={t.research.heading}>
  <div class="research">
    <p class="research__paper"><cite>{t.research.paper}</cite></p>
    <p class="research__venue">{t.research.venue}</p>
    <p class="research__summary">{t.research.summary}</p>
    <p class="research__detail">{t.research.detail}</p>
    <p>
      <CtaLink
        href={PUBLICATION_URL}
        label={t.research.cta.label}
        external
        indicator={externalIndicator}
        variant="outline"
      />
    </p>
  </div>
</HomeSection>

<style>
  .research {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--width-reading);
  }

  .research__paper cite {
    font-size: var(--text-md);
    font-style: normal;
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .research__venue {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .research__summary {
    margin-block-start: var(--space-2);
    line-height: var(--leading-relaxed);
  }

  .research__detail {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }
</style>
