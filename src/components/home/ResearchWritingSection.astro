---
/**
 * Technical Writing — one date-and-title list in Study's form: the latest
 * Study posts, then the journal paper as the last row, then a link to all of
 * Study (PRD §9.5, §9.6).
 *
 * Metadata only — date, category, title. PRD §9.6 forbids duplicating full
 * articles here and keeps Study the canonical publication platform;
 * `src/lib/study-feed.ts` enforces that upstream by never parsing an article
 * body in the first place.
 *
 * The paper is listed here rather than in a section of its own (PRD §9.5 and
 * §8 forbid promoting a single paper into its own navigation entry). Its link
 * resolves through the DOI, so it survives the article being moved.
 *
 * Three states are normal rather than exceptional:
 *
 *   - No posts. An unreachable feed, a timeout, or a build with no network at
 *     all resolves to an empty list (PRD §28 requires the build to survive it),
 *     in which case the paper row and the link to all writing still render.
 *     There is no error message: a visitor is not the audience for a build-time
 *     fetch failure, and the reason is already in the build log.
 *   - No category. Study's feed declares none today, so the category only
 *     appears for entries that carry one.
 *   - A title in another language. Study publishes in Chinese, so the English
 *     page shows Chinese titles. PRD §7 forbids machine-translating them, and
 *     doc-2 §9 asks for the honest alternative: keep the original and mark it.
 *     `resolveTitle` decides when that is true — it says so only on the feed's
 *     own evidence, never by guessing from the characters — and the badge names
 *     the language in the reader's own language.
 */

import { LOCALE_TAG, type Locale } from '../../i18n/locales';
import type { HomeStrings } from '../../i18n/pages/home';
import { PUBLICATION_URL, STUDY_URL } from '../../lib/external';
import { localizePath } from '../../lib/i18n';
import { resolveTitle, type StudyPost } from '../../lib/study-feed';
import CtaLink from './CtaLink.astro';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
  t: HomeStrings;
  /** Latest Study posts, already limited and ordered by `getStudyPosts`. */
  posts: readonly StudyPost[];
  /** Localized off-site glyph, from the chrome dictionary. */
  externalIndicator: string;
}

const { locale, t, posts, externalIndicator } = Astro.props;

/* Built once per render rather than per post; `dateStyle: 'medium'` gives each
   locale its own conventional form instead of imposing one format on both. */
const dateFormat = new Intl.DateTimeFormat(LOCALE_TAG[locale], { dateStyle: 'medium' });

/**
 * Everything the list needs, resolved before the markup.
 *
 * The language decision in particular is one expression rather than a condition
 * repeated across two attributes: `badge` and `lang` must agree, since one is
 * how a sighted reader learns the title is in another language and the other is
 * how a screen reader pronounces it.
 */
const entries = posts.map((post) => {
  const title = resolveTitle(post, locale);

  return {
    url: post.url,
    date: post.date,
    displayDate: dateFormat.format(new Date(post.date)),
    category: post.category,
    title: title.text,
    lang: title.locale ? LOCALE_TAG[title.locale] : undefined,
    badge: title.isForeignLanguage && title.locale ? t.writing.languages[title.locale] : undefined,
  };
});
---

<HomeSection id="technical-writing" heading={t.writing.heading}>
  <ul class="writing" role="list">
    {
      entries.map((entry) => (
        <li class="entry">
          <p class="entry__when">
            <time datetime={entry.date}>{entry.displayDate}</time>
          </p>
          <div class="entry__body">
            <p class="entry__title">
              <a href={entry.url} target="_blank" rel="noopener noreferrer" lang={entry.lang}>
                {entry.title}
              </a>
            </p>
            {(entry.category || entry.badge) && (
              <p class="entry__meta">
                {entry.category && <span>{entry.category}</span>}
                {entry.badge && <span>{entry.badge}</span>}
              </p>
            )}
          </div>
        </li>
      ))
    }
    <li class="entry">
      <p class="entry__when">{t.research.year}</p>
      <div class="entry__body">
        <p class="entry__title">
          <a href={PUBLICATION_URL} target="_blank" rel="noopener noreferrer" lang="en">
            {t.research.paper}
          </a>
        </p>
        <p class="entry__meta">{t.research.venue}</p>
      </div>
    </li>
  </ul>

  <p class="writing__all">
    <CtaLink href={STUDY_URL} label={t.writing.cta.label} external indicator={externalIndicator} />
  </p>

  <p class="writing__about">
    {t.experience.progression}{' '}
    <a href={localizePath(locale, '/about')}>{t.experience.cta.label}</a>
  </p>
</HomeSection>

<style>
  .writing {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The date on the left and the title on the right from a tablet up; a stack
     beneath that. `minmax(0, 1fr)` keeps a long unbroken title from widening
     a 390px viewport. */
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1);
  }

  @media (width >= 48rem) {
    .entry {
      grid-template-columns: 12rem minmax(0, 1fr);
      column-gap: var(--space-5);
    }
  }

  /* Dates and categories are metadata, so they step down to the subtle text
     level; the title link beside them stays full contrast. */
  .entry__when,
  .entry__meta {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .entry__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }

  .entry__title {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .writing__all {
    margin-block-start: var(--space-5);
  }

  .writing__about {
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
