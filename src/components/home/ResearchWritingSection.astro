---
/**
 * Three curated investigations (stable editorial topics), one peer-reviewed
 * publication, and a quiet latest-feed pointer. Study remains the canonical
 * article home; the homepage never copies entire article bodies.
 */
import { LOCALE_TAG, type Locale } from '../../i18n/locales';
import type { HomeStrings } from '../../i18n/pages/home';
import { PUBLICATION_URL, STUDY_URL } from '../../lib/external';
import { resolveTitle, type StudyPost } from '../../lib/study-feed';
import CtaLink from './CtaLink.astro';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
  t: HomeStrings;
  posts: readonly StudyPost[];
  externalIndicator: string;
  index: string;
}

const { locale, t, posts, externalIndicator, index } = Astro.props;

/* The newest article is context, not a randomly replacing featured selection.
   Exclude exact selected URLs so the same item is not shown twice. */
const latest = posts.find((post) => !t.writing.selected.some((item) => item.href === post.url));
const latestTitle = latest ? resolveTitle(latest, locale) : undefined;
const latestDate = latest
  ? new Intl.DateTimeFormat(LOCALE_TAG[locale], { dateStyle: 'medium' }).format(
      new Date(latest.date),
    )
  : undefined;
---

<HomeSection id="technical-writing" heading={t.writing.heading} index={index}>
  <ul class="selected" role="list">
    {
      t.writing.selected.map((item) => (
        <li class="selected__item">
          <p class="selected__area">{item.area}</p>
          <div class="selected__body">
            <h3 class="selected__topic">
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.topic}
              </a>
            </h3>
            <p class="selected__description">{item.description}</p>
            {item.language !== locale && (
              <p class="selected__language">{t.writing.languages[item.language]}</p>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  <div class="publication">
    <p class="publication__meta">{t.research.year} · {t.research.venue}</p>
    <h3 class="publication__title">
      <a href={PUBLICATION_URL} target="_blank" rel="noopener noreferrer" lang="en">
        {t.research.paper}
      </a>
    </h3>
  </div>

  {
    latest && latestTitle && (
      <div class="latest">
        <p class="latest__label">{t.writing.latestHeading}</p>
        <p>
          <time datetime={latest.date}>{latestDate}</time>
          {' · '}
          <a
            href={latest.url}
            target="_blank"
            rel="noopener noreferrer"
            lang={latestTitle.locale ? LOCALE_TAG[latestTitle.locale] : undefined}
          >
            {latestTitle.text}
          </a>
          {latestTitle.isForeignLanguage && latestTitle.locale && (
            <span class="latest__language"> · {t.writing.languages[latestTitle.locale]}</span>
          )}
        </p>
      </div>
    )
  }

  <p class="writing__all">
    <CtaLink href={STUDY_URL} label={t.writing.cta.label} external indicator={externalIndicator} />
  </p>
</HomeSection>

<style>
  .selected {
    display: flex;
    flex-direction: column;
    max-width: var(--width-reading);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .selected__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  @media (width >= 48rem) {
    .selected__item {
      grid-template-columns: 14rem minmax(0, 1fr);
      column-gap: var(--space-5);
    }
  }

  .selected__item:last-child {
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .selected__area,
  .selected__language,
  .publication__meta,
  .latest__label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-subtle);
  }

  .selected__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .selected__topic {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .selected__description {
    max-width: 55ch;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .publication {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: var(--width-reading);
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .publication__title {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .latest {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: var(--width-reading);
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .latest > p:last-child {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    overflow-wrap: anywhere;
  }

  .latest__language {
    font-size: var(--text-sm);
  }

  .writing__all {
    margin-block-start: var(--space-5);
    font-family: var(--font-mono);
  }
</style>
