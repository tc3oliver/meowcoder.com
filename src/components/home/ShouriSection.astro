---
/**
 * Featured Product — Shouri (MCD-17, doc-2 §6).
 *
 * Shouri is the strongest product proof on the site, so doc-2 §6 makes this the
 * most visually prominent section on the homepage. Two things do that, and both
 * are the opposite of what this section used to do.
 *
 * The first is the layout. Every other homepage section is text held to the
 * reading measure; this one spans the full content width as an asymmetric
 * 40% copy / 60% visual pair, and the screenshot is the larger half. It used to
 * be capped at `--width-reading` to line up with the paragraph above it — that
 * cap is gone, because doc-2 §6 asks for a product visual that leads the page
 * rather than a figure that sits politely inside the prose.
 *
 * The second is what was removed. The section carried a product summary, three
 * principles with a sentence each, and a six-item "Engineering areas" list.
 * doc-2 §6 cuts that to one statement and three principle names: the areas were
 * claims without evidence at homepage size, and the engineering detail behind
 * them is on the Shouri case study, which `caseStudyCta` links to. Less copy
 * beside a larger image is what the asymmetry is made of — the copy column has
 * to be short enough to sit beside the visual rather than run past it.
 *
 * The screenshot is still conditional — see `shouri-screenshot.ts` for what it
 * needs and why. Without it the section degrades to a single column of copy.
 */

import { Image } from 'astro:assets';

import type { Locale } from '../../i18n/locales';
import type { HomeStrings } from '../../i18n/pages/home';
import { SHOURI_URL } from '../../lib/external';
import { localizePath, workDetailRoute } from '../../lib/i18n';
import CtaLink from './CtaLink.astro';
import HomeSection from './HomeSection.astro';
import { shouriScreenshot } from './shouri-screenshot';

interface Props {
  locale: Locale;
  t: HomeStrings;
  externalIndicator: string;
}

const { locale, t, externalIndicator } = Astro.props;

/** The case study's slug — `src/content/work/{en,zh}/shouri.md`. */
const CASE_STUDY_SLUG = 'shouri';

/**
 * The case study in the reader's own locale, routed through the same helpers
 * the Work index uses so this link cannot drift from the page it points at.
 */
const caseStudyHref = localizePath(locale, workDetailRoute(CASE_STUDY_SLUG));

/**
 * doc-2 §6 prints the three principles as one compact row. The middot is a
 * separator between three names, not punctuation inside a sentence, so it is
 * joined here rather than written into either locale's strings — the same
 * treatment `OpenSourceSection` gives the two skill names.
 */
const principles = t.shouri.principles.join(' · ');

const { screenshot } = t.shouri;
---

<HomeSection id="featured-product" eyebrow={t.shouri.eyebrow} heading={t.shouri.heading}>
  <div class="shouri">
    <div class="shouri__copy">
      <p class="shouri__summary">{t.shouri.summary}</p>

      <p class="shouri__principles">{principles}</p>

      <div class="shouri__actions">
        <CtaLink href={caseStudyHref} label={t.shouri.caseStudyCta.label} variant="outline" />
        <CtaLink
          href={SHOURI_URL}
          label={t.shouri.cta.label}
          external
          indicator={externalIndicator}
          variant="outline"
        />
      </div>
    </div>

    {
      shouriScreenshot && screenshot && (
        <figure class="shouri__figure">
          <Image
            src={shouriScreenshot}
            alt={screenshot.alt}
            widths={[480, 640, 960, 1280]}
            sizes="(min-width: 72.5rem) 640px, (min-width: 64rem) 58vw, 100vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }
  </div>
</HomeSection>

<style>
  /* One column by default, copy first. doc-2 §17 wants the product visual
     immediately after its copy at ~390px, and source order gives that for free
     — no `order` juggling, and it is also the order a screen reader hears. */
  .shouri {
    display: grid;
    /* `minmax(0, 1fr)` rather than the implicit `auto`: the image is wider
       than a phone, and an `auto` track can be forced open by its content.
       This is what keeps 390px free of a horizontal scrollbar (doc-2 §17). */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
  }

  /* doc-2 §6's 40 / 60 split. `minmax(0, …)` on both tracks so the image can
     shrink below its intrinsic width instead of forcing the grid wider than
     the container, which is what would put a horizontal scrollbar on the page.

     The switch is at 64rem rather than the 48rem this file used before: at
     768px a 40% column is about 280px, which is too narrow for the statement
     to read as the section's lead line. Below the breakpoint the section is
     one column and the image is full width, which is more prominent still. */
  @media (min-width: 64rem) {
    .shouri {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-8);
    }
  }

  .shouri__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    /* Only matters in the one-column layout, where the copy would otherwise
       stretch to the full 1160px content width. */
    max-width: var(--width-reading);
  }

  .shouri__summary {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  /* The three principle names, as one line. Monospace and muted so the row
     reads as a set of labels beneath the statement rather than as a second
     sentence — the same treatment Open Source gives its two skill names. */
  .shouri__principles {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-normal);
  }

  .shouri__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* No `max-width`. This is the 60% half of the section and the largest single
     element on the homepage — the reading measure that used to cap it here is
     for prose, and holding a product visual to it is what made this section
     read as text with an illustration. */
  .shouri__figure {
    margin: 0;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface);
  }

  /* The rendered box is the column, not the asset's own 1536px. Astro still
     writes `width` and `height` onto the tag, so the aspect ratio is known
     before the bytes arrive and the image reserves its own space — the figure
     grew, but it still costs no layout shift. */
  .shouri__figure :global(img) {
    inline-size: 100%;
  }
</style>
