---
/**
 * The research lead is an investigation, not a metric wall. The published
 * laya-apple case study anchors the measured result; other experiments remain
 * visible in a quieter evidence ledger. OSS belongs to its own section.
 */
import type { Locale } from '../../i18n/locales';
import type { HomeStrings, ResearchProjectId } from '../../i18n/pages/home';
import {
  INFERENCE_SYSTEMS_ARTICLE_URL,
  INFERENCE_SYSTEMS_URL,
  LAYA_APPLE_ARTICLE_EN_URL,
  LAYA_APPLE_ARTICLE_URL,
  LAYA_APPLE_URL,
  MI300X_URL,
  QWEN38_5070TI_ARTICLE_URL,
  QWEN38_5070TI_URL,
} from '../../lib/external';
import { localizePath, workDetailRoute } from '../../lib/i18n';
import CtaLink from './CtaLink.astro';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
  t: HomeStrings;
  externalIndicator: string;
  index: string;
}

const { locale, t, externalIndicator, index } = Astro.props;

const LINKS: Record<ResearchProjectId, { slug?: string; article?: string; repo: string }> = {
  'laya-apple': {
    slug: 'laya-apple',
    article: locale === 'en' ? LAYA_APPLE_ARTICLE_EN_URL : LAYA_APPLE_ARTICLE_URL,
    repo: LAYA_APPLE_URL,
  },
  'llm-inference-systems': {
    slug: 'llm-inference-systems',
    article: INFERENCE_SYSTEMS_ARTICLE_URL,
    repo: INFERENCE_SYSTEMS_URL,
  },
  'deepseek-v4-flash-mi300x': { repo: MI300X_URL },
  'qwen3.8-27b-5070ti-eval': {
    article: QWEN38_5070TI_ARTICLE_URL,
    repo: QWEN38_5070TI_URL,
  },
};

const featured = t.systems.projects.find((project) => project.id === 'laya-apple');
const others = t.systems.projects.filter((project) => project.id !== 'laya-apple');
---

<HomeSection id="featured-research" heading={t.systems.heading} index={index}>
  {
    featured && (
      <article class="feature">
        <div class="feature__story">
          <h3>{t.systems.flagship.title}</h3>
          <p class="feature__summary">{t.systems.flagship.summary}</p>
          <p class="feature__method">{t.systems.flagship.method}</p>
          <div class="feature__links">
            <CtaLink
              href={localizePath(locale, workDetailRoute('laya-apple'))}
              label={t.systems.flagship.linkLabel}
              variant="text"
            />
            {LINKS[featured.id].article && (
              <CtaLink
                href={LINKS[featured.id].article!}
                label={featured.articleCta?.label ?? t.systems.articleCta.label}
                external
                indicator={externalIndicator}
              />
            )}
          </div>
        </div>
        <dl class="feature__evidence">
          <dt>{featured.stat.label}</dt>
          <dd>{featured.stat.value}</dd>
        </dl>
      </article>
    )
  }

  <h3 class="more-heading">{t.systems.resultsHeading}</h3>
  <ul class="results" role="list">
    {
      others.map((project) => {
        const links = LINKS[project.id];
        const href = links.slug ? localizePath(locale, workDetailRoute(links.slug)) : links.repo;
        return (
          <li class="result">
            <p class="result__stat">{project.stat.value}</p>
            <div class="result__body">
              <p class="result__name">
                <a
                  href={href}
                  target={links.slug ? undefined : '_blank'}
                  rel={links.slug ? undefined : 'noopener noreferrer'}
                >
                  {project.name}
                </a>
              </p>
              <p class="result__label">
                {project.stat.label}
                {links.article && (
                  <>
                    {' '}
                    <CtaLink
                      href={links.article}
                      label={project.articleCta?.label ?? t.systems.articleCta.label}
                      external
                      indicator={externalIndicator}
                    />
                  </>
                )}
              </p>
              {project.note && <p class="result__label">{project.note}</p>}
            </div>
          </li>
        );
      })
    }
  </ul>
</HomeSection>

<style>
  /* A feature without a card: a single shared baseline and an asymmetric
     evidence rail carry the hierarchy, continuing the site's ledger identity. */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-7);
    border-block: var(--border-width) solid var(--color-border);
  }

  @media (width >= 56rem) {
    .feature {
      grid-template-columns: minmax(0, 1fr) minmax(15rem, 19rem);
      column-gap: var(--space-9);
      align-items: start;
    }
  }

  .feature__story {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    min-width: 0;
  }

  .feature__story h3 {
    max-width: 23ch;
    font-size: var(--text-xl);
    line-height: var(--leading-heading);
  }

  .feature__summary {
    max-width: 49ch;
    color: var(--color-text-muted);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }

  .feature__method {
    max-width: 52ch;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-subtle);
  }

  .feature__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding-block-start: var(--space-2);
  }

  .feature__evidence {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-3);
    min-width: 0;
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .feature__evidence dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .feature__evidence dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .more-heading {
    margin-block: var(--space-8) var(--space-4);
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
  }

  .results {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: var(--width-reading);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .result {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1);
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  @media (width >= 48rem) {
    .result {
      grid-template-columns: 14rem minmax(0, 1fr);
      column-gap: var(--space-5);
    }

    .result__stat {
      white-space: nowrap;
    }
  }

  .result__stat {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-snug);
  }

  .result__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .result__name {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    overflow-wrap: anywhere;
  }

  .result__label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
</style>
