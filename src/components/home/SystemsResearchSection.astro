---
/**
 * Research — a ruled ledger block in the reading column: the measured results
 * of four projects (laya-apple, LLM Inference Systems, the MI300X DeepSeek V4
 * Flash baseline, the Qwen3.8-27B evaluation on one RTX 5070 Ti), then the
 * OSS project summaries. The detailed PR ledger lives on GitHub.
 *
 * It carries numbers rather than figures: research is proved by what it
 * measured, and a chart shrunk to homepage size is unreadable decoration. The
 * charts stay on the case study and the article.
 *
 * Round 2 sets the summary in the ledger register — hairline rules top and
 * bottom of the block (never a box: a four-sided hairline is a card, and PRD
 * §25 forbids them), the measured values in mono, the sub-headings quiet.
 *
 * Every number in `home.ts` for this section is quoted from the project's own
 * case study, which names the data it comes from — or, for the MI300X baseline,
 * which has no case study, from `bench-results/README.md`'s concurrent
 * sub-agent table; for the RTX 5070 Ti evaluation, from the repository's
 * `EVIDENCE-INDEX.md`, quoting each ID's value as written.
 */

import type { Locale } from '../../i18n/locales';
import type { HomeStrings, ResearchProjectId } from '../../i18n/pages/home';
import {
  INFERENCE_SYSTEMS_ARTICLE_URL,
  INFERENCE_SYSTEMS_URL,
  LAYA_APPLE_ARTICLE_EN_URL,
  LAYA_APPLE_ARTICLE_URL,
  LAYA_APPLE_URL,
  MI300X_URL,
  QWEN38_5070TI_ARTICLE_URL,
  QWEN38_5070TI_URL,
  UPSTREAM_PRS_URL,
} from '../../lib/external';
import { localizePath, workDetailRoute } from '../../lib/i18n';
import CtaLink from './CtaLink.astro';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
  t: HomeStrings;
  externalIndicator: string;
  /** Two-digit ledger index for the section heading row. */
  index: string;
}

const { locale, t, externalIndicator, index } = Astro.props;

/**
 * Where each project's links go. The name links to the case study, or to the
 * repository when there is none; the article, where one exists, trails the
 * row. The slug is the case study's —
 * `src/content/work/{en,zh}/<slug>.md` — and is routed through the same helpers
 * the Work index uses, so these links cannot drift from the pages they name.
 */
const LINKS: Record<ResearchProjectId, { slug?: string; article?: string; repo: string }> = {
  // laya-apple's write-up exists in both languages: Study in Chinese, an X
  // article in English.
  'laya-apple': {
    slug: 'laya-apple',
    article: locale === 'en' ? LAYA_APPLE_ARTICLE_EN_URL : LAYA_APPLE_ARTICLE_URL,
    repo: LAYA_APPLE_URL,
  },
  'llm-inference-systems': {
    slug: 'llm-inference-systems',
    article: INFERENCE_SYSTEMS_ARTICLE_URL,
    repo: INFERENCE_SYSTEMS_URL,
  },
  'deepseek-v4-flash-mi300x': { repo: MI300X_URL },
  'qwen3.8-27b-5070ti-eval': { article: QWEN38_5070TI_ARTICLE_URL, repo: QWEN38_5070TI_URL },
};
---

<HomeSection id="featured-research" heading={t.systems.heading} index={index}>
  <div class="ledger">
    <h3 class="list-heading">{t.systems.resultsHeading}</h3>
    <ul class="results" role="list">
      {
        t.systems.projects.map((project) => {
          const links = LINKS[project.id];
          const href = links.slug ? localizePath(locale, workDetailRoute(links.slug)) : links.repo;
          return (
            <li class="result">
              <p class="result__stat">{project.stat.value}</p>
              <div class="result__body">
                <p class="result__name">
                  <a
                    href={href}
                    target={links.slug ? undefined : '_blank'}
                    rel={links.slug ? undefined : 'noopener noreferrer'}
                  >
                    {project.name}
                  </a>
                </p>
                <p class="result__label">
                  {project.stat.label}
                  {links.article && (
                    <>
                      {' '}
                      <CtaLink
                        href={links.article}
                        label={project.articleCta?.label ?? t.systems.articleCta.label}
                        external
                        indicator={externalIndicator}
                      />
                    </>
                  )}
                </p>
                {project.note && <p class="result__label">{project.note}</p>}
              </div>
            </li>
          );
        })
      }
    </ul>

    <h3 class="list-heading">{t.systems.upstream.heading}</h3>
    <ul class="upstream" role="list">
      {
        t.systems.upstream.items.map((item) => (
          <li class="upstream__item">
            <p class="upstream__name">
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.name}
              </a>
            </p>
            <p class="upstream__description">{item.description}</p>
          </li>
        ))
      }
    </ul>
    <p class="upstream__all">
      <CtaLink
        href={UPSTREAM_PRS_URL}
        label={t.systems.upstream.cta.label}
        external
        indicator={externalIndicator}
      />
    </p>
  </div>
</HomeSection>

<style>
  /* The ruled ledger block: reading-column width, hairline rules top and
     bottom, no box. The rules span the block; the block never spans the
     content width, which keeps prose at its measure inside a wide page. */
  .ledger {
    max-width: var(--width-reading);
    padding-block: var(--space-6);
    border-block: var(--border-width) solid var(--color-border);
  }

  /* Sub-headings take the quiet metadata register: mono at the subtle level.
     No letter-spacing — these labels are visible on zh pages. */
  .list-heading {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-normal);
  }

  .results,
  .upstream {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .results {
    margin-block: var(--space-4) var(--space-8);
  }

  .upstream {
    margin-block-start: var(--space-4);
  }

  /* The number on the left and the project on the right from a tablet up; a
     stack beneath that. `minmax(0, 1fr)` keeps a long repository name in the
     right column from widening a 390px viewport. */
  .result {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1);
  }

  @media (width >= 48rem) {
    .result {
      /* 14rem holds the longest value on one line: JetBrains Mono advances
         0.6em at every weight, so `228.38 → 79.06 s` (16 characters) measures
         ~221px at the 23px top of --text-lg, inside the 224px column. */
      grid-template-columns: 14rem minmax(0, 1fr);
      column-gap: var(--space-5);
    }

    /* One line here only — the stacked mobile column keeps its wrap, so a
       value can never push a 390px viewport sideways. */
    .result__stat {
      white-space: nowrap;
    }
  }

  /* The measured value is the row's ledger entry: mono, tabular. */
  .result__stat {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-snug);
  }

  .result__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .result__name {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    overflow-wrap: anywhere;
  }

  .result__label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .upstream__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .upstream__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-normal);
    /* Project names wrap if they outgrow a narrow viewport. */
    overflow-wrap: anywhere;
  }

  .upstream__description {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .upstream__all {
    margin-block-start: var(--space-5);
    font-family: var(--font-mono);
  }
</style>
