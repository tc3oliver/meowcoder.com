---
/**
 * Systems Research — laya-apple.
 *
 * The homepage had no route to the site's deepest engineering evidence: the
 * laya-apple case study, its preregistered research and the upstream Core ML
 * fix were reachable only from the Work index. This section puts that work one
 * scroll below Open Source, as the second section that carries a figure.
 *
 * The layout is Shouri's 40 / 60 copy / figure pair, so the two sections that
 * carry a visual read as a set. The chart's labels are small at 60% width;
 * the full-size PNG is one click away in the laya-apple repository, and the
 * one number the figure establishes is stated in the caption.
 *
 * Every number in `home.ts` for this section traces to the laya-apple
 * repository (`docs/media/research/README.md` lists the source of each one in
 * the figure), and the article link goes live only after the Study post does.
 */

import { Image } from 'astro:assets';

import gilStall from '../../assets/laya-apple/gil-stall.png';
import type { Locale } from '../../i18n/locales';
import type { HomeStrings } from '../../i18n/pages/home';
import { LAYA_APPLE_ARTICLE_URL, LAYA_APPLE_URL } from '../../lib/external';
import { localizePath, workDetailRoute } from '../../lib/i18n';
import CtaLink from './CtaLink.astro';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
  t: HomeStrings;
  externalIndicator: string;
}

const { locale, t, externalIndicator } = Astro.props;

/** The case study's slug — `src/content/work/{en,zh}/laya-apple.md`. */
const CASE_STUDY_SLUG = 'laya-apple';
const caseStudyHref = localizePath(locale, workDetailRoute(CASE_STUDY_SLUG));
---

<HomeSection id="systems-research" eyebrow={t.systems.eyebrow} heading={t.systems.heading}>
  <div class="systems">
    <div class="systems__copy">
      <p class="systems__statement">{t.systems.statement}</p>
      <p class="systems__meta">{t.systems.meta}</p>

      <div class="systems__actions">
        <CtaLink href={caseStudyHref} label={t.systems.caseStudyCta.label} variant="outline" />
        <CtaLink
          href={LAYA_APPLE_ARTICLE_URL}
          label={t.systems.articleCta.label}
          external
          indicator={externalIndicator}
          variant="outline"
        />
        <CtaLink
          href={LAYA_APPLE_URL}
          label={t.systems.cta.label}
          external
          indicator={externalIndicator}
          variant="outline"
        />
      </div>
    </div>

    <figure class="systems__figure">
      <Image
        src={gilStall}
        alt={t.systems.figure.alt}
        widths={[640, 960, 1280, 1920]}
        sizes="(min-width: 72.5rem) 640px, (min-width: 64rem) 58vw, 100vw"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="systems__caption">{t.systems.figure.caption}</figcaption>
    </figure>
  </div>
</HomeSection>

<style>
  .systems {
    display: grid;
    /* `minmax(0, 1fr)` so the 2400px chart cannot force the track wider than a
       390px viewport — the same guard the Shouri section uses. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }

  /* Shouri's 40 / 60 split, at the same breakpoint. */
  @media (min-width: 64rem) {
    .systems {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-8);
    }
  }

  .systems__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: var(--width-reading);
  }

  .systems__statement {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }

  /* Facts, not prose: the same muted monospace line Open Source uses. */
  .systems__meta {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-normal);
  }

  .systems__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .systems__figure {
    margin: 0;
  }

  /* The chart is drawn on white; the frame keeps it from reading as a hole in
     the page on the dark theme. */
  .systems__figure :global(img) {
    inline-size: 100%;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: #fff;
  }

  .systems__caption {
    margin-block-start: var(--space-3);
    max-width: var(--width-reading);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
</style>
