---
/**
 * Featured Research — laya-apple, LLM Inference Systems, and the MI300X
 * DeepSeek V4 Flash baseline: Apple silicon and AMD ROCm side by side.
 *
 * The homepage had no route to the site's deepest engineering evidence: two
 * research programs with raw data behind every number, and the upstream fixes
 * they produced, were reachable only from the Work index. This section puts
 * them directly beneath Shouri, as the homepage's second lead proof.
 *
 * It carries numbers rather than figures. A product is proved by what it looks
 * like, so Shouri keeps its screenshot; research is proved by what it measured,
 * and a chart shrunk to homepage size is unreadable decoration. Each project
 * leads with one measured result, stated large, and its charts stay on the case
 * study and the article where they can be read.
 *
 * Every number in `home.ts` for this section is quoted from the project's own
 * case study, which names the data it comes from — or, for the MI300X baseline,
 * which has no case study, from `bench-results/README.md`'s concurrent
 * sub-agent table.
 */

import type { Locale } from '../../i18n/locales';
import type { HomeStrings, ResearchProjectId } from '../../i18n/pages/home';
import {
  INFERENCE_SYSTEMS_ARTICLE_URL,
  INFERENCE_SYSTEMS_URL,
  LAYA_APPLE_ARTICLE_EN_URL,
  LAYA_APPLE_ARTICLE_URL,
  LAYA_APPLE_URL,
  MI300X_URL,
} from '../../lib/external';
import { localizePath, workDetailRoute } from '../../lib/i18n';
import CtaLink from './CtaLink.astro';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
  t: HomeStrings;
  externalIndicator: string;
}

const { locale, t, externalIndicator } = Astro.props;

/**
 * Where each project's actions go. A project without a case study or an
 * article simply has fewer actions; the repository is always there. The slug is the case study's —
 * `src/content/work/{en,zh}/<slug>.md` — and is routed through the same helpers
 * the Work index uses, so these links cannot drift from the pages they name.
 */
const LINKS: Record<ResearchProjectId, { slug?: string; article?: string; repo: string }> = {
  // laya-apple's write-up exists in both languages: Study in Chinese, an X
  // article in English.
  'laya-apple': {
    slug: 'laya-apple',
    article: locale === 'en' ? LAYA_APPLE_ARTICLE_EN_URL : LAYA_APPLE_ARTICLE_URL,
    repo: LAYA_APPLE_URL,
  },
  'llm-inference-systems': {
    slug: 'llm-inference-systems',
    article: INFERENCE_SYSTEMS_ARTICLE_URL,
    repo: INFERENCE_SYSTEMS_URL,
  },
  'deepseek-v4-flash-mi300x': { repo: MI300X_URL },
};
---

<HomeSection id="featured-research" eyebrow={t.systems.eyebrow} heading={t.systems.heading}>
  <div class="research-projects">
    {
      t.systems.projects.map((project) => {
        const links = LINKS[project.id];
        return (
          <article class="project">
            <h3 class="project__name">{project.name}</h3>
            <p class="project__stat">{project.stat.value}</p>
            <p class="project__stat-label">{project.stat.label}</p>
            <p class="project__statement">{project.statement}</p>
            <p class="project__meta">{project.meta}</p>
            <div class="project__actions">
              {links.slug && (
                <CtaLink
                  href={localizePath(locale, workDetailRoute(links.slug))}
                  label={t.systems.caseStudyCta.label}
                  variant="outline"
                />
              )}
              {links.article && (
                <CtaLink
                  href={links.article}
                  label={project.articleCta?.label ?? t.systems.articleCta.label}
                  external
                  indicator={externalIndicator}
                  variant="text"
                />
              )}
              <CtaLink
                href={links.repo}
                label={t.systems.cta.label}
                external
                indicator={externalIndicator}
                variant={links.slug ? 'text' : 'outline'}
              />
            </div>
          </article>
        );
      })
    }
  </div>
</HomeSection>

<style>
  /* Three projects in a row on a desktop, two on a tablet, one on a phone. `minmax(0, 1fr)` keeps a long number from forcing a 390px
     viewport wider than the screen. */
  .research-projects {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }

  @media (width >= 48rem) {
    .research-projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .research-projects {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .project {
    display: flex;
    flex-direction: column;
    max-width: var(--width-reading);
  }

  .project__name {
    font-size: var(--text-md);
    letter-spacing: var(--tracking-normal);
  }

  /* The measured result is the section's visual: large, tabular, and the
     first thing the eye lands on after the name. */
  .project__stat {
    margin-block-start: var(--space-5);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
  }

  .project__stat-label {
    margin-block-start: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .project__statement {
    margin-block-start: var(--space-5);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }

  /* Facts, not prose: the same muted monospace line Open Source uses. */
  .project__meta {
    margin-block-start: var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-normal);
  }

  /* One outlined action per project, the case study; the article and the
     repository are text links beside it, so each card has a clear primary. */
  .project__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-block-start: var(--space-5);
  }
</style>
