---
/**
 * In-page section navigation for a case study (MCD-22, doc-2 §12).
 *
 * The source is the article itself. `render()` hands back the headings it found
 * in the Markdown together with the `id` it wrote onto each one, so the links
 * below cannot drift from the document: adding, renaming, or reordering a `##`
 * in a content file changes this list in the same build.
 *
 * Only `depth === 2` is navigable. Deeper headings exist inside decision blocks
 * and are part of a section's own structure, not a destination.
 *
 * No client JavaScript (PRD §26, §29). Plain anchors do the scrolling, the
 * global `:focus-visible` ring makes each one keyboard-visible, and
 * `scroll-padding-top` in `global.css` keeps a target off the viewport edge.
 *
 * Round 2 turns the desktop list into the ledger index: mono at the smallest
 * step, subtle labels, and the reader's current section marked in text color
 * with a 2px accent left border — driven by the URL fragment and `:has()`,
 * still without a line of script.
 */

import type { MarkdownHeading } from 'astro';

interface Props {
  /** Every heading `render()` reported, in document order. */
  headings: readonly MarkdownHeading[];
  /** Localized heading over the list. */
  label: string;
}

const { headings, label } = Astro.props;

const sections = headings.filter((heading) => heading.depth === 2);

/*
 * The ledger index marks the section the reader is in — with no client
 * JavaScript to watch the scroll. What the document does carry is the URL
 * fragment: clicking a contents link (or the article's own anchor) makes one
 * heading `:target`, and one generated rule per section turns that into the
 * marked nav entry via `:has()`. Attribute selectors rather than `#slug` keep
 * slugs that are Chinese text or start with a digit valid. Progressive by
 * nature: a browser without `:has()` simply shows no mark.
 */
const currentRules = sections
  .map(
    (section) =>
      `body:has([id="${section.slug}"]:target) .section-nav__list a[href="#${section.slug}"] {
        color: var(--color-text);
        border-inline-start-color: var(--color-accent);
      }`,
  )
  .join('\n');
---

{
  sections.length > 0 && (
    <nav class="section-nav" aria-label={label}>
      <details>
        <summary>{label}</summary>
        <ol class="section-nav__list" role="list">
          {sections.map((section) => (
            <li>
              <a href={`#${section.slug}`}>{section.text}</a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

{
  /* Generated, one rule per section: the reader's current section in text
    color with its accent rule lit. Unscoped by necessity — the selectors come
    from the article's own headings at build time, so Astro's scope hash
    cannot apply. */
}
{sections.length > 0 && <style set:html={currentRules} />}

<style>
  .section-nav {
    border-block: var(--border-width) solid var(--color-border);
  }

  .section-nav summary {
    min-height: 2.75rem;
    padding-block: var(--space-3);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  /* Narrow screens get a wrapping row: ten section names read as a compact
     contents strip above the article instead of a column the reader has to
     scroll past to reach the first paragraph. */
  .section-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    padding-block-end: var(--space-4);
  }

  .section-nav__list a {
    overflow-wrap: anywhere;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .section-nav__list a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Matches the sidebar breakpoint in `WorkLayout.astro`: once the sidebar is a
     column of its own, the list becomes a column too — and a ledger index:
     mono at the smallest step, subtle, each entry carrying the transparent
     2px rule the `:target` rules below light up in accent for the section the
     reader is in. */
  @media (min-width: 72rem) {
    .section-nav {
      border-block: 0;
    }

    .section-nav summary {
      display: block;
      min-height: auto;
      margin-block-end: var(--space-3);
      padding: 0;
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      cursor: default;
      pointer-events: none;
    }

    .section-nav summary::marker {
      content: '';
    }

    /* Keep one set of section links in the DOM. On desktop the sidebar exposes
       that list directly even though the mobile disclosure remains closed. */
    .section-nav details:not([open]) > .section-nav__list {
      display: flex;
    }

    .section-nav__list {
      flex-direction: column;
      gap: var(--space-3);
      padding-block-end: 0;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      /* Long section names wrap inside the column rather than widening it. */
      text-wrap: pretty;
    }

    .section-nav__list a {
      color: var(--color-text-subtle);
      padding-inline-start: var(--space-3);
      border-inline-start: 2px solid transparent;
    }
  }
</style>
