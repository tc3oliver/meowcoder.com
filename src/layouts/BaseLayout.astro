---
/**
 * Base page shell (MCD-2, extended for bilingual metadata in MCD-3).
 *
 * Owns the document skeleton — `<head>` metadata, the header/main/footer
 * landmarks, and the stylesheet — so every page inherits the same design system
 * without repeating it.
 *
 * Pages identify themselves by `locale` + `route`, never by URL. Canonical,
 * `hreflang`, and Open Graph URLs are all derived from that pair here, which is
 * what stops them from drifting apart (PRD §7).
 *
 * `Header` and `Footer` are the defaults of named slots rather than fixed
 * markup, so a page can supply locale-aware instances.
 */

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALE_TAG, OG_LOCALE, type Locale } from '../i18n/locales';
import { alternatesFor, localizeUrl, type Route } from '../lib/i18n';

interface Props {
  locale: Locale;
  route: Route;
  title: string;
  description: string;
  /** Localized skip-link text. Omitted means no skip link is rendered. */
  skipLinkLabel?: string;
}

const { locale, route, title, description, skipLinkLabel } = Astro.props;

const canonical = localizeUrl(locale, route);
const alternates = alternatesFor(route);
---

<!doctype html>
<html lang={LOCALE_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Tells the browser to paint its own canvas, scrollbars, and form
    controls in the resolved theme, which is what keeps the very first frame
    from flashing a light background on a dark-mode device. */
    }
    <meta name="color-scheme" content="light dark" />

    {
      /* Declaring the icon stops browsers probing `/favicon.ico`, which the
    site does not serve and which Lighthouse counts as a console error. */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="meowcoder.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta name="twitter:card" content="summary" />

    <slot name="head" />
  </head>
  <body>
    {
      skipLinkLabel && (
        <a class="skip-link" href="#main">
          {skipLinkLabel}
        </a>
      )
    }

    <slot name="header"><Header /></slot>

    <main id="main" class="site-main">
      <slot />
    </main>

    <slot name="footer"><Footer /></slot>
  </body>
</html>
