---
/**
 * Work index (MCD-21, doc-2 §11).
 *
 * The counterpart to `WorkLayout`: one structure driving both `/work/` and
 * `/zh/work/`, so the two indexes cannot drift into listing different things
 * in different shapes.
 *
 * The page is a plain list in the homepage's reading column: a number on the
 * left, and on the right the title as the only link, then the type, the
 * outcome and the evidence label in muted text — with the number and the
 * evidence label, both metadata, one level fainter in subtle. No entry
 * carries a visual, a card or a button; the title is the one link, so a
 * screen reader hears distinct destinations without hidden suffixes.
 *
 * Entries arrive already filtered and ordered by `workEntriesForLocale`; this
 * layout only renders them.
 */

import type { Locale } from '../i18n/locales';
import { work } from '../i18n/pages/work';
import { localizePath, workDetailRoute } from '../lib/i18n';
import type { WorkEntry } from '../lib/work';
import SiteShell from './SiteShell.astro';

interface Props {
  locale: Locale;
  entries: readonly WorkEntry[];
}

const { locale, entries } = Astro.props;

const t = work[locale];

/** `01`, `02` — the position each entry is numbered by. */
function position(index: number): string {
  return String(index + 1).padStart(2, '0');
}
---

<SiteShell locale={locale} route="/work" title={t.title} description={t.description}>
  <div class="container work-index-page">
    <header class="work-index__header">
      <h1>{t.heading}</h1>
      <p class="work-index__intro">{t.intro}</p>
    </header>

    {
      entries.length === 0 ? (
        <p class="work-index__empty">{t.empty}</p>
      ) : (
        <ul class="work-index" role="list">
          {entries.map((entry, index) => {
            const label = entry.data.indexMeta ?? entry.data.evidence;

            return (
              <li class="work-row">
                {/* Decoration: the list already carries the ordering. */}
                <span class="work-row__num" aria-hidden="true">
                  {position(index)}
                </span>
                <div class="work-row__body">
                  <h2 class="work-row__title">
                    <a href={localizePath(locale, workDetailRoute(entry.data.slug))}>
                      {entry.data.title}
                    </a>
                  </h2>
                  <p class="work-row__type">{entry.data.type}</p>
                  <p class="work-row__outcome">{entry.data.outcome ?? entry.data.summary}</p>
                  {label && <p class="work-row__evidence">{label}</p>}
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</SiteShell>

<style>
  /* Same column as the homepage: reading measure, left-aligned with the
     header's content edge. */
  .work-index-page {
    max-width: var(--width-reading);
    margin-inline-start: max(0px, calc((100% - var(--width-content)) / 2));
    margin-inline-end: auto;
  }

  .work-index__header {
    margin-block-end: var(--space-8);
  }

  .work-index__intro {
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .work-index {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The number on the left and the entry on the right from a tablet up; a
     stack beneath that. `minmax(0, 1fr)` keeps a long unbroken label from
     widening a 390px viewport. */
  .work-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1);
  }

  @media (width >= 48rem) {
    .work-row {
      grid-template-columns: 4rem minmax(0, 1fr);
      column-gap: var(--space-5);
    }
  }

  .work-row__num {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
  }

  .work-row__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .work-row__title {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }

  .work-row__type,
  .work-row__outcome,
  .work-row__evidence {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .work-row__evidence {
    /* An evidence label is metadata, so it sits one level below the outcome
       sentence it annotates. */
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    /* A host or package name has no break opportunity, and one unbreakable
       token would set the page's minimum width at 390px. */
    overflow-wrap: anywhere;
  }

  .work-index__empty {
    color: var(--color-text-muted);
  }
</style>
