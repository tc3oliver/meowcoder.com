---
/**
 * Work detail page (MCD-5, MCD-22, PRD §10, doc-2 §12).
 *
 * One layout for both locales. `/work/[slug].astro` and
 * `/zh/work/[slug].astro` differ only in which locale constant they pass, so a
 * case study cannot render differently in English than it does in Chinese.
 *
 * The rendered Markdown arrives through the default slot rather than being
 * rendered here, which keeps this layout free of `astro:content` and lets it be
 * reasoned about as plain markup. The `headings` prop arrives from the same
 * `render()` call the slot content came from, which is what lets the sidebar
 * navigate an article this file never parses.
 *
 * Nothing below is keyed on a slug. Both case studies get the same shell, and a
 * third would too.
 */

import type { MarkdownHeading } from 'astro';

import StructuredData from '../components/StructuredData.astro';
import WorkSidebar from '../components/work/WorkSidebar.astro';
import { chrome } from '../i18n/chrome';
import type { Locale } from '../i18n/locales';
import { work } from '../i18n/pages/work';
import { localizePath, workDetailRoute } from '../lib/i18n';
import { aiCodingSkillsSchema, shouriSchema } from '../lib/structured-data';
import { socialPreview } from '../lib/social';
import type { WorkEntryData } from '../lib/work';
import SiteShell from './SiteShell.astro';

interface Props {
  locale: Locale;
  entry: WorkEntryData;
  /**
   * Headings `render()` found in the body, for the sidebar's section list.
   * Optional so the layout still renders an article with no headings at all.
   */
  headings?: readonly MarkdownHeading[];
}

const { locale, entry, headings = [] } = Astro.props;

const t = work[locale];
const isExperience = entry.kind === 'experience';

/*
 * Same shape as every dictionary title (`Work — Oliver Yu`), composed rather
 * than translated: the case-study title is already localized in the content
 * file, and the wordmark is a proper name PRD §7 leaves untranslated.
 */
const detailTitles = {
  en: {
    shouri: 'Shouri / 收理 — AI Information Organizer | Oliver Yu',
    'ai-coding-skills': 'AI Coding Skills — Agent Engineering | Oliver Yu',
    'professional-engineering': 'Professional Engineering Experience — Oliver Yu',
  },
  zh: {
    shouri: 'Shouri / 收理 — AI 資訊整理工具 | Oliver Yu',
    'ai-coding-skills': 'AI Coding Skills — Agent 工程 | Oliver Yu',
    'professional-engineering': '專業工程經歷 — Oliver Yu',
  },
} as const;

const title =
  detailTitles[locale][entry.slug as keyof (typeof detailTitles)[typeof locale]] ??
  `${entry.title} — ${chrome[locale].brand}`;
const previewName =
  entry.slug === 'shouri' || entry.slug === 'ai-coding-skills' ? entry.slug : 'default';

/*
 * PRD §30 asks for a `SoftwareApplication`/`Product` node for Shouri
 * specifically, so this is keyed on the slug rather than emitted for every case
 * study. AI Coding Skills is open-source work, not a product, and has no
 * equivalent node in §30.
 */
const schemas =
  entry.slug === 'shouri'
    ? [shouriSchema(locale)]
    : entry.slug === 'ai-coding-skills'
      ? [aiCodingSkillsSchema(locale, entry.summary)]
      : [];
---

<SiteShell
  locale={locale}
  route={workDetailRoute(entry.slug)}
  title={title}
  description={entry.summary}
  socialImage={socialPreview(locale, previewName)}
>
  {schemas.length > 0 && <StructuredData slot="head" schemas={schemas} />}
  <article class:list={['container', 'work', isExperience && 'work--experience']}>
    <header class="work__header">
      <h1>{entry.title}</h1>
      <p class="work__summary">{entry.summary}</p>
      {
        isExperience && entry.meta && (
          <dl class="work__header-meta" aria-label={t.experienceOverviewLabel}>
            {entry.meta.map((row) => (
              <div class="work__header-meta-row">
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>

    {!isExperience && <WorkSidebar entry={entry} headings={headings} t={t} />}

    <div class="work__body">
      <div class="prose">
        <slot />
      </div>

      <footer class="work__footer">
        {isExperience && <a href={localizePath(locale, '/about')}>{t.aboutOliver}</a>}
        <a href={localizePath(locale, '/work')}>{t.backToIndex}</a>
      </footer>
    </div>
  </article>
</SiteShell>

<style>
  /* Below the breakpoint the page is a single column held to the reading
     measure, so `.container`'s content width is narrowed rather than filled
     with a 720px article floating in it.

     Written as `.container.work` rather than `.work`: Astro's scope hash adds no
     specificity, so a bare `.work` would tie `.container` in `global.css` and
     leave the winner up to stylesheet order. */
  .container.work {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-7);
    max-width: var(--width-reading);
  }

  .work__header {
    max-width: var(--width-reading);
  }

  .work__summary {
    margin-block-start: var(--space-3);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .work__header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-7);
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .work__header-meta-row {
    min-width: min(100%, 11rem);
  }

  .work__header-meta dt {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .work__header-meta dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .work__footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-block-start: var(--space-9);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
    font-size: var(--text-sm);
  }

  .work--experience .work__body {
    max-width: 48.75rem;
  }

  /*
   * 70rem is the first width at which the two columns fit without squeezing the
   * measure: 720px of article + a 4rem gutter + a 15rem sidebar is 1008px, and
   * `.container` offers about 1052px there. Below it, a sidebar could only be
   * bought by taking width from the article, which is the wrong trade on a
   * page whose job is reading.
   *
   * The article column takes the leftover width and the text inside it stays at
   * the measure, which is what keeps both outer edges — article and sidebar —
   * flush with the site header and footer above and below them.
   */
  @media (min-width: 70rem) {
    .container.work {
      grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
      column-gap: var(--space-9);
      max-width: var(--width-content);
    }

    .work__header {
      grid-column: 1;
      grid-row: 1;
    }

    .work__body {
      grid-column: 1;
      grid-row: 2;
      max-width: var(--width-reading);
    }

    /* Spans both rows so the sticky inner block can start level with the title
       and travel the whole article. */
    .work :global(.work-aside) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .container.work--experience {
      grid-template-columns: minmax(0, 48.75rem);
      max-width: 48.75rem;
    }

    .work--experience .work__body {
      grid-column: 1;
      grid-row: 2;
    }
  }
</style>
