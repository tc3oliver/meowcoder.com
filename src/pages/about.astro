---
/**
 * English About page (MCD-8, PRD §13–§17).
 *
 * The page owns its locale and metadata; the body is `AboutContent`, shared
 * with the Chinese route so both locales stay structurally identical.
 */

import AboutContent from '../components/about/AboutContent.astro';
import { about } from '../i18n/pages/about';
import SiteShell from '../layouts/SiteShell.astro';

const locale = 'en' as const;
const t = about[locale];
---

<SiteShell locale={locale} route="/about" title={t.title} description={t.description}>
  <AboutContent t={t} />
</SiteShell>
