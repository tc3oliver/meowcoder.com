---
/**
 * English home page (MCD-4).
 *
 * The route owns its locale, its metadata, and the build-time feed read; the
 * body is `HomeContent`, shared with `/zh/` so both locales stay structurally
 * identical (PRD §35).
 *
 * `getStudyPosts` never rejects — an unreachable feed resolves to an empty list
 * so the build survives with no network at all (PRD §28) — so there is no error
 * handling to do here.
 */

import HomeContent from '../components/home/HomeContent.astro';
import StructuredData from '../components/StructuredData.astro';
import { chrome } from '../i18n/chrome';
import { home } from '../i18n/pages/home';
import SiteShell from '../layouts/SiteShell.astro';
import { getStudyPosts } from '../lib/study-feed';
import { personSchema, webSiteSchema } from '../lib/structured-data';

const locale = 'en' as const;
const t = home[locale];

/**
 * doc-2 §9 narrows PRD §9.6's "latest 3–5 posts" to exactly 3, which is
 * `DEFAULT_POST_LIMIT` — so the count is decided at the source rather than
 * restated per route, and the two locales cannot ask for different lists.
 */
const { posts } = await getStudyPosts();
---

<SiteShell locale={locale} route="/" title={t.title} description={t.description}>
  <StructuredData slot="head" schemas={[personSchema(locale), webSiteSchema(locale)]} />

  <HomeContent
    locale={locale}
    t={t}
    posts={posts}
    externalIndicator={chrome[locale].nav.externalIndicator}
  />
</SiteShell>
