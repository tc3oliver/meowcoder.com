---
/**
 * English home page (MCD-3 shell).
 *
 * Homepage sections — Hero, Shouri, Engineering Expertise, Open Source,
 * Research, Technical Writing, Professional Experience — arrive in MCD-4.
 */

import { home } from '../i18n/pages/home';
import SiteShell from '../layouts/SiteShell.astro';

const locale = 'en' as const;
const t = home[locale];
---

<SiteShell locale={locale} route="/" title={t.title} description={t.description}>
  <div class="container">
    <div class="prose">
      <h1>{t.heading}</h1>
      <p>{t.intro}</p>
    </div>
  </div>
</SiteShell>
