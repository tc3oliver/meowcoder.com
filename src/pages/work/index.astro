---
/**
 * English Work index (MCD-3 shell). The content collection, entries, and detail
 * layout arrive in MCD-5.
 */

import { work } from '../../i18n/pages/work';
import SiteShell from '../../layouts/SiteShell.astro';

const locale = 'en' as const;
const t = work[locale];
---

<SiteShell locale={locale} route="/work" title={t.title} description={t.description}>
  <div class="container">
    <div class="prose">
      <h1>{t.heading}</h1>
      <p>{t.intro}</p>
    </div>
  </div>
</SiteShell>
