---
/**
 * Traditional Chinese About page (MCD-8, PRD §13–§17).
 *
 * A complete localized page, not English content with translated labels
 * (PRD §7): every string comes from the `zh` side of the About dictionary.
 */

import AboutContent from '../../components/about/AboutContent.astro';
import StructuredData from '../../components/StructuredData.astro';
import { about } from '../../i18n/pages/about';
import SiteShell from '../../layouts/SiteShell.astro';
import { publicationSchema } from '../../lib/structured-data';

const locale = 'zh' as const;
const t = about[locale];
---

<SiteShell locale={locale} route="/about" title={t.title} description={t.description}>
  <StructuredData slot="head" schemas={[publicationSchema(locale)]} />
  <AboutContent t={t} />
</SiteShell>
