---
/**
 * Traditional Chinese home page (MCD-4).
 *
 * A complete localized experience, not mixed-language content inside the
 * English page (PRD §7). It renders the same `HomeContent` in the same order as
 * `/`, with the Chinese dictionary — PRD §35 requires both locales to share one
 * information architecture.
 *
 * Study post titles are the exception: they appear in whatever language Study
 * published them, because PRD §7 forbids machine-translating them at runtime.
 * `getStudyPosts` memoizes per feed URL, so this page shares one request with
 * the English page rather than fetching twice per build.
 */

import HomeContent from '../../components/home/HomeContent.astro';
import StructuredData from '../../components/StructuredData.astro';
import { chrome } from '../../i18n/chrome';
import { home } from '../../i18n/pages/home';
import SiteShell from '../../layouts/SiteShell.astro';
import { getStudyPosts } from '../../lib/study-feed';
import { personSchema, webSiteSchema } from '../../lib/structured-data';

const locale = 'zh' as const;
const t = home[locale];

const { posts } = await getStudyPosts();
---

<SiteShell locale={locale} route="/" title={t.title} description={t.description}>
  <StructuredData slot="head" schemas={[personSchema(locale), webSiteSchema(locale)]} />

  <HomeContent
    locale={locale}
    t={t}
    posts={posts}
    externalIndicator={chrome[locale].nav.externalIndicator}
  />
</SiteShell>
