---
/**
 * Traditional Chinese Work detail page (MCD-5).
 *
 * The same slugs as the English detail page, under `/zh/` — which is what lets
 * the language switch move between them by rewriting the prefix alone.
 */

import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';

import WorkLayout from '../../../layouts/WorkLayout.astro';
import { workEntriesForLocale } from '../../../lib/work';

const locale = 'zh' as const;

export const getStaticPaths = (async () => {
  const entries = workEntriesForLocale(await getCollection('work'), 'zh');

  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;

/*
 * `headings` is the same pass that produced `Content`, so the section
 * navigation in `WorkLayout` links to ids that are certain to exist in the
 * markup below it (MCD-22).
 */
const { Content, headings } = await render(entry);
---

<WorkLayout locale={locale} entry={entry.data} headings={headings}>
  <Content />
</WorkLayout>
