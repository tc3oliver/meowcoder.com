---
/**
 * Traditional Chinese Work index (MCD-5).
 *
 * Identical to the English index apart from the locale constant.
 */

import { getCollection } from 'astro:content';

import WorkIndexLayout from '../../../layouts/WorkIndexLayout.astro';
import { workEntriesForLocale } from '../../../lib/work';

const locale = 'zh' as const;

const entries = workEntriesForLocale(await getCollection('work'), locale);
---

<WorkIndexLayout locale={locale} entries={entries} />
